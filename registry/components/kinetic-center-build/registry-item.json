{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "kinetic-center-build",
  "type": "hyperframes:component",
  "title": "Kinetic Center Build",
  "description": "A centered phrase builder where words push into place until the line locks.",
  "tags": ["motion-primitive", "remocn-port", "typography"],
  "files": [
    {
      "path": "kinetic-center-build.html",
      "target": "compositions/components/kinetic-center-build.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [
    {
      "id": "size",
      "type": "enum",
      "role": "layout",
      "label": "Size",
      "description": "Type size of the phrase.",
      "default": "standard",
      "options": [
        {
          "value": "compact",
          "label": "Compact"
        },
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "display",
          "label": "Display"
        }
      ]
    },
    {
      "id": "tone",
      "type": "enum",
      "role": "style",
      "label": "Tone",
      "description": "Word colour: ink for light frames, paper for dark ones, accent rides the brand token.",
      "default": "ink",
      "options": [
        {
          "value": "ink",
          "label": "Ink"
        },
        {
          "value": "paper",
          "label": "Paper"
        },
        {
          "value": "accent",
          "label": "Accent"
        }
      ]
    },
    {
      "id": "spacing",
      "type": "enum",
      "role": "layout",
      "label": "Spacing",
      "description": "The gap between words in the phrase.",
      "default": "standard",
      "options": [
        {
          "value": "tight",
          "label": "Tight"
        },
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "loose",
          "label": "Loose"
        }
      ]
    },
    {
      "id": "direction",
      "type": "enum",
      "role": "motion",
      "label": "Direction",
      "description": "Where the offset the timeline drives points, so words push in from below, above, or the side.",
      "default": "up",
      "options": [
        {
          "value": "up",
          "label": "Up"
        },
        {
          "value": "down",
          "label": "Down"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    }
  ],
  "preview": {
    "poster": "https://static.heygen.ai/hyperframes-oss/docs/images/catalog/components/kinetic-center-build.png"
  }
}
