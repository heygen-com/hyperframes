{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "backdrop",
  "type": "hyperframes:component",
  "title": "Backdrop",
  "description": "An Operator Black flat dimming backdrop for dialog, drawer, sheet, and modal scenes.",
  "tags": ["ui-primitive", "remocn-port"],
  "files": [
    {
      "path": "backdrop.html",
      "target": "compositions/components/backdrop.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [
    {
      "id": "dim",
      "type": "enum",
      "role": "style",
      "label": "Dim",
      "description": "How far the backdrop darkens the scene underneath once its fade lands.",
      "default": "standard",
      "options": [
        { "value": "sheer", "label": "Sheer" },
        { "value": "standard", "label": "Standard" },
        { "value": "blackout", "label": "Blackout" }
      ]
    },
    {
      "id": "tint",
      "type": "enum",
      "role": "style",
      "label": "Tint",
      "description": "Colour the dimming layer is mixed from: neutral black, a cool ink, or a warm plum.",
      "default": "black",
      "options": [
        { "value": "black", "label": "Black" },
        { "value": "ink", "label": "Ink" },
        { "value": "plum", "label": "Plum" }
      ]
    },
    {
      "id": "frost",
      "type": "enum",
      "role": "style",
      "label": "Frost",
      "description": "Optional blur applied to whatever the backdrop covers, for a frosted glass sheet.",
      "default": "none",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "soft", "label": "Soft" },
        { "value": "heavy", "label": "Heavy" }
      ]
    }
  ],
  "preview": {
    "poster": "https://static.heygen.ai/hyperframes-oss/docs/images/catalog/components/backdrop.png"
  }
}
