{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "card",
  "type": "hyperframes:component",
  "title": "Card",
  "description": "A single semantic card surface with calm type hierarchy, success status, a review action, and Soft Optical reveal hooks",
  "tags": ["ui-primitive", "remocn-port", "card", "surface"],
  "files": [
    {
      "path": "card.html",
      "target": "compositions/components/card.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [
    {
      "id": "theme",
      "type": "enum",
      "role": "style",
      "label": "Theme",
      "description": "Operator Black token theme the card renders in.",
      "default": "dark",
      "options": [
        { "value": "dark", "label": "Dark" },
        { "value": "light", "label": "Light" }
      ]
    },
    {
      "id": "accent",
      "type": "enum",
      "role": "style",
      "label": "Accent",
      "description": "Accent token family used for the status text and focus rings.",
      "default": "green",
      "options": [
        { "value": "green", "label": "Green" },
        { "value": "blue", "label": "Blue" },
        { "value": "amber", "label": "Amber" },
        { "value": "violet", "label": "Violet" }
      ]
    },
    {
      "id": "density",
      "type": "enum",
      "role": "style",
      "label": "Density",
      "description": "Padding and row spacing inside the card.",
      "default": "comfortable",
      "options": [
        { "value": "comfortable", "label": "Comfortable" },
        { "value": "compact", "label": "Compact" }
      ]
    }
  ],
  "preview": {
    "poster": "https://static.heygen.ai/hyperframes-oss/docs/images/catalog/components/card.png"
  }
}
