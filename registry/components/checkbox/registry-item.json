{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "checkbox",
  "type": "hyperframes:component",
  "title": "Checkbox",
  "description": "An accessible checkbox with tactile feedback and a functional mint check state",
  "tags": ["ui-primitive", "remocn-port", "checkbox", "control"],
  "files": [
    {
      "path": "checkbox.html",
      "target": "compositions/components/checkbox.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [
    {
      "id": "accent",
      "type": "enum",
      "role": "style",
      "label": "Accent",
      "description": "Token family that fills the box and its border once the check lands.",
      "default": "mint",
      "options": [
        {
          "value": "mint",
          "label": "Mint"
        },
        {
          "value": "blue",
          "label": "Blue"
        },
        {
          "value": "violet",
          "label": "Violet"
        }
      ]
    },
    {
      "id": "size",
      "type": "enum",
      "role": "style",
      "label": "Size",
      "description": "Box edge length; the tick and the label text scale with it.",
      "default": "standard",
      "options": [
        {
          "value": "compact",
          "label": "Compact"
        },
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ]
    },
    {
      "id": "label",
      "type": "string",
      "role": "content",
      "label": "Label",
      "description": "Text shown beside the box.",
      "default": "Include captions",
      "maxLength": 60
    }
  ],
  "preview": {
    "poster": "https://static.heygen.ai/hyperframes-oss/docs/images/catalog/components/checkbox.png"
  }
}
