{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "button",
  "type": "hyperframes:component",
  "title": "Button",
  "description": "A video-safe action button with tactile press, loading, and success states",
  "tags": ["ui-primitive", "remocn-port", "button", "control"],
  "files": [
    {
      "path": "button.html",
      "target": "compositions/components/button.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [
    {
      "id": "label",
      "type": "string",
      "role": "content",
      "label": "Label",
      "description": "Text shown on the button while it is idle.",
      "default": "Continue"
    },
    {
      "id": "variant",
      "type": "enum",
      "role": "style",
      "label": "Variant",
      "description": "Filled action, raised secondary surface, or a transparent outline.",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "secondary",
          "label": "Secondary"
        },
        {
          "value": "outline",
          "label": "Outline"
        }
      ]
    },
    {
      "id": "theme",
      "type": "enum",
      "role": "style",
      "label": "Theme",
      "description": "Operator Black dark surface or the light-frame token set.",
      "default": "dark",
      "options": [
        {
          "value": "dark",
          "label": "Dark"
        },
        {
          "value": "light",
          "label": "Light"
        }
      ]
    }
  ],
  "preview": {
    "poster": "https://static.heygen.ai/hyperframes-oss/docs/images/catalog/components/button.png"
  }
}
