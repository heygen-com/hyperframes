{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "spring-scale-in",
  "type": "hyperframes:component",
  "title": "Spring Scale In",
  "description": "Words pop in with soft overshoot scale like a physical spring settling.",
  "tags": ["motion-primitive", "remocn-port", "typography"],
  "files": [
    {
      "path": "spring-scale-in.html",
      "target": "compositions/components/spring-scale-in.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [
    {
      "id": "words",
      "type": "string",
      "role": "content",
      "label": "Words",
      "description": "Words on screen, split on whitespace so each one gets its own stagger step.",
      "default": "Spring scale in"
    },
    {
      "id": "pop",
      "type": "enum",
      "role": "motion",
      "label": "Pop",
      "description": "Scales how far below final size the words start before the spring settles them.",
      "default": "standard",
      "options": [
        {
          "value": "subtle",
          "label": "Subtle"
        },
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "bold",
          "label": "Bold"
        }
      ]
    },
    {
      "id": "distance",
      "type": "enum",
      "role": "motion",
      "label": "Distance",
      "description": "Scales the vertical offset the words rise through, so they cover a shorter or longer run in the same time.",
      "default": "standard",
      "options": [
        {
          "value": "close",
          "label": "Close"
        },
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "far",
          "label": "Far"
        }
      ]
    },
    {
      "id": "tone",
      "type": "enum",
      "role": "style",
      "label": "Tone",
      "description": "Word colour: ink for light frames, paper for dark ones, accent rides --brand.",
      "default": "ink",
      "options": [
        {
          "value": "ink",
          "label": "Ink"
        },
        {
          "value": "paper",
          "label": "Paper"
        },
        {
          "value": "accent",
          "label": "Accent"
        }
      ]
    }
  ],
  "preview": {
    "poster": "https://static.heygen.ai/hyperframes-oss/docs/images/catalog/components/spring-scale-in.png"
  }
}
