{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "select",
  "type": "hyperframes:component",
  "title": "Select",
  "description": "An origin-aware select with a matte menu and explicit selected option",
  "tags": ["ui-primitive", "remocn-port", "select", "control"],
  "files": [
    {
      "path": "select.html",
      "target": "compositions/components/select.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [
    {
      "id": "label",
      "type": "string",
      "role": "content",
      "label": "Label",
      "description": "Value shown on the trigger and on the selected row of the menu.",
      "default": "1080p"
    },
    {
      "id": "width",
      "type": "enum",
      "role": "layout",
      "label": "Width",
      "description": "Minimum width of the trigger, which the menu tracks.",
      "default": "standard",
      "options": [
        {
          "value": "compact",
          "label": "Compact"
        },
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ]
    },
    {
      "id": "placement",
      "type": "enum",
      "role": "layout",
      "label": "Placement",
      "description": "Which side the menu opens on, under the trigger or over it.",
      "default": "below",
      "options": [
        {
          "value": "below",
          "label": "Below"
        },
        {
          "value": "above",
          "label": "Above"
        }
      ]
    },
    {
      "id": "accent",
      "type": "enum",
      "role": "style",
      "label": "Accent",
      "description": "Colour of the tick on the selected row. theme leaves the shared accent token in charge.",
      "default": "theme",
      "options": [
        {
          "value": "theme",
          "label": "Theme"
        },
        {
          "value": "blue",
          "label": "Blue"
        },
        {
          "value": "amber",
          "label": "Amber"
        },
        {
          "value": "violet",
          "label": "Violet"
        }
      ]
    }
  ],
  "preview": {
    "poster": "https://static.heygen.ai/hyperframes-oss/docs/images/catalog/components/select.png"
  }
}
