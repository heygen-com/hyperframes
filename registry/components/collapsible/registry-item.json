{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "collapsible",
  "type": "hyperframes:component",
  "title": "Collapsible",
  "description": "A compact disclosure surface with an accessible trigger, restrained chevron motion, and deterministic height reveal",
  "tags": ["ui-primitive", "remocn-port", "collapsible", "disclosure"],
  "files": [
    {
      "path": "collapsible.html",
      "target": "compositions/components/collapsible.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [
    {
      "id": "label",
      "type": "string",
      "role": "content",
      "label": "Trigger label",
      "description": "Text on the disclosure trigger.",
      "default": "Advanced settings",
      "maxLength": 60
    },
    {
      "id": "reveal-height",
      "type": "number",
      "role": "layout",
      "label": "Reveal height",
      "description": "How far the body opens at full progress; raise it when the body copy is longer than two lines.",
      "default": 120,
      "min": 48,
      "max": 400,
      "step": 4,
      "unit": "px"
    },
    {
      "id": "chevron",
      "type": "enum",
      "role": "motion",
      "label": "Chevron",
      "description": "How far the chevron turns across the reveal.",
      "default": "half",
      "options": [
        {
          "value": "half",
          "label": "Half turn"
        },
        {
          "value": "quarter",
          "label": "Quarter turn"
        },
        {
          "value": "none",
          "label": "Still"
        }
      ]
    }
  ],
  "preview": {
    "poster": "https://static.heygen.ai/hyperframes-oss/docs/images/catalog/components/collapsible.png"
  }
}
