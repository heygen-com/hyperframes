{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "popover",
  "type": "hyperframes:component",
  "title": "Popover",
  "description": "An Operator Black anchored popover with a matte surface and trigger-origin Soft Optical motion",
  "tags": ["ui-primitive", "remocn-port", "popover", "overlay"],
  "files": [
    {
      "path": "popover.html",
      "target": "compositions/components/popover.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [
    {
      "id": "placement",
      "type": "enum",
      "role": "layout",
      "label": "Placement",
      "description": "Which side of the anchor the panel sits on, and therefore which way it settles as it opens.",
      "default": "below",
      "options": [
        {
          "value": "below",
          "label": "Below"
        },
        {
          "value": "above",
          "label": "Above"
        }
      ]
    },
    {
      "id": "gap",
      "type": "number",
      "role": "layout",
      "label": "Gap",
      "description": "Distance between the anchor and the panel edge.",
      "default": 12,
      "min": 4,
      "max": 40,
      "step": 1,
      "unit": "px"
    },
    {
      "id": "accent",
      "type": "enum",
      "role": "style",
      "label": "Accent",
      "description": "Colour family for the panel outline and its heading. Neutral leaves the theme border and heading colours alone.",
      "default": "neutral",
      "options": [
        {
          "value": "neutral",
          "label": "Neutral"
        },
        {
          "value": "green",
          "label": "Green"
        },
        {
          "value": "blue",
          "label": "Blue"
        },
        {
          "value": "violet",
          "label": "Violet"
        }
      ]
    },
    {
      "id": "label",
      "type": "string",
      "role": "content",
      "label": "Anchor label",
      "description": "Text on the button the panel is anchored to.",
      "default": "Format"
    }
  ],
  "preview": {
    "poster": "https://static.heygen.ai/hyperframes-oss/docs/images/catalog/components/popover.png"
  }
}
