{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "scroll-area",
  "type": "hyperframes:component",
  "title": "Scroll Area",
  "description": "A focused matte viewport with spacing-led list content and synchronized seek-safe scrollbar motion",
  "tags": ["ui-primitive", "remocn-port", "scroll-area", "layout"],
  "files": [
    {
      "path": "scroll-area.html",
      "target": "compositions/components/scroll-area.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [
    {
      "id": "height",
      "type": "enum",
      "role": "layout",
      "label": "Height",
      "description": "Height of the viewport, which decides how much of the list is visible at once.",
      "default": "standard",
      "options": [
        {
          "value": "compact",
          "label": "Compact"
        },
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "tall",
          "label": "Tall"
        }
      ]
    },
    {
      "id": "density",
      "type": "enum",
      "role": "layout",
      "label": "Density",
      "description": "Row height, padding, type size and the gap between rows.",
      "default": "standard",
      "options": [
        {
          "value": "compact",
          "label": "Compact"
        },
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "roomy",
          "label": "Roomy"
        }
      ]
    },
    {
      "id": "scrollbar",
      "type": "enum",
      "role": "style",
      "label": "Scrollbar",
      "description": "Thumb treatment: a thin muted bar, a wider brighter one, or no bar at all.",
      "default": "subtle",
      "options": [
        {
          "value": "subtle",
          "label": "Subtle"
        },
        {
          "value": "prominent",
          "label": "Prominent"
        },
        {
          "value": "hidden",
          "label": "Hidden"
        }
      ]
    },
    {
      "id": "travel",
      "type": "enum",
      "role": "motion",
      "label": "Travel",
      "description": "Scales the scroll offsets the timeline drives, so the list covers more or less ground in the same time.",
      "default": "standard",
      "options": [
        {
          "value": "near",
          "label": "Near"
        },
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "far",
          "label": "Far"
        }
      ]
    }
  ],
  "preview": {
    "poster": "https://static.heygen.ai/hyperframes-oss/docs/images/catalog/components/scroll-area.png"
  }
}
