{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "kbd",
  "type": "hyperframes:component",
  "title": "Kbd",
  "description": "A physical keyboard legend with machined keycap depth, system monospace type, and finite press motion",
  "tags": ["ui-primitive", "remocn-port", "kbd", "shortcut"],
  "files": [
    {
      "path": "kbd.html",
      "target": "compositions/components/kbd.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [
    {
      "id": "label",
      "type": "string",
      "role": "content",
      "label": "Label",
      "description": "Legend printed on the keycap, such as Cmd K or Esc.",
      "default": "Cmd K"
    },
    {
      "id": "size",
      "type": "enum",
      "role": "layout",
      "label": "Size",
      "description": "Cap height, side padding, and legend size together.",
      "default": "standard",
      "options": [
        {
          "value": "compact",
          "label": "Compact"
        },
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ]
    },
    {
      "id": "tone",
      "type": "enum",
      "role": "style",
      "label": "Tone",
      "description": "Legend and edge colour family: plain, accent green, data blue, or data violet.",
      "default": "neutral",
      "options": [
        {
          "value": "neutral",
          "label": "Neutral"
        },
        {
          "value": "accent",
          "label": "Accent"
        },
        {
          "value": "blue",
          "label": "Blue"
        },
        {
          "value": "violet",
          "label": "Violet"
        }
      ]
    },
    {
      "id": "depth",
      "type": "enum",
      "role": "style",
      "label": "Depth",
      "description": "Thickness of the bottom edge that gives the cap its travel.",
      "default": "standard",
      "options": [
        {
          "value": "flat",
          "label": "Flat"
        },
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "deep",
          "label": "Deep"
        }
      ]
    }
  ],
  "preview": {
    "poster": "https://static.heygen.ai/hyperframes-oss/docs/images/catalog/components/kbd.png"
  }
}
