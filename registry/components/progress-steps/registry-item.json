{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "progress-steps",
  "type": "hyperframes:component",
  "title": "Progress Steps",
  "description": "A vertical progress sequence with clear complete, current, and waiting states.",
  "tags": ["ui-primitive", "remocn-port"],
  "files": [
    {
      "path": "progress-steps.html",
      "target": "compositions/components/progress-steps.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [
    {
      "id": "fill",
      "type": "number",
      "role": "content",
      "label": "Fill",
      "description": "How much of the rail is filled, as a percentage of the list height. Values outside the range are clamped to it.",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%"
    },
    {
      "id": "accent",
      "type": "enum",
      "role": "style",
      "label": "Accent",
      "description": "Colour family for the filled rail and the step markers. Theme leaves the inherited accent token alone.",
      "default": "theme",
      "options": [
        {
          "value": "theme",
          "label": "Theme"
        },
        {
          "value": "blue",
          "label": "Blue"
        },
        {
          "value": "violet",
          "label": "Violet"
        },
        {
          "value": "amber",
          "label": "Amber"
        }
      ]
    },
    {
      "id": "density",
      "type": "enum",
      "role": "layout",
      "label": "Density",
      "description": "Row height, with the rail insets kept centred on the first and last markers.",
      "default": "standard",
      "options": [
        {
          "value": "compact",
          "label": "Compact"
        },
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "roomy",
          "label": "Roomy"
        }
      ]
    },
    {
      "id": "entrance",
      "type": "enum",
      "role": "motion",
      "label": "Entrance",
      "description": "Scales the sideways offset the timeline drives, so rows slide in from closer or further out in the same time.",
      "default": "standard",
      "options": [
        {
          "value": "subtle",
          "label": "Subtle"
        },
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "bold",
          "label": "Bold"
        }
      ]
    }
  ],
  "preview": {
    "poster": "https://static.heygen.ai/hyperframes-oss/docs/images/catalog/components/progress-steps.png"
  }
}
