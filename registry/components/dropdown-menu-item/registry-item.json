{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "dropdown-menu-item",
  "type": "hyperframes:component",
  "title": "Dropdown Menu Item",
  "description": "An Operator Black menu-row specimen showing idle, hover, selected, and disabled treatments.",
  "tags": ["ui-primitive", "remocn-port"],
  "files": [
    {
      "path": "dropdown-menu-item.html",
      "target": "compositions/components/dropdown-menu-item.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [
    {
      "id": "accent",
      "type": "enum",
      "role": "style",
      "label": "Accent",
      "description": "Colour of the check mark on the selected row.",
      "default": "mint",
      "options": [
        { "value": "mint", "label": "Mint" },
        { "value": "blue", "label": "Blue" },
        { "value": "violet", "label": "Violet" }
      ]
    },
    {
      "id": "density",
      "type": "enum",
      "role": "style",
      "label": "Density",
      "description": "Row height and horizontal padding.",
      "default": "comfortable",
      "options": [
        { "value": "comfortable", "label": "Comfortable" },
        { "value": "compact", "label": "Compact" }
      ]
    },
    {
      "id": "hint",
      "type": "enum",
      "role": "style",
      "label": "Hint",
      "description": "Whether the trailing shortcut column is shown.",
      "default": "shortcut",
      "options": [
        { "value": "shortcut", "label": "Shortcut" },
        { "value": "hidden", "label": "Hidden" }
      ]
    }
  ],
  "preview": {
    "poster": "https://static.heygen.ai/hyperframes-oss/docs/images/catalog/components/dropdown-menu-item.png"
  }
}
