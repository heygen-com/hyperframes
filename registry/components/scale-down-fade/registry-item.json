{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "scale-down-fade",
  "type": "hyperframes:component",
  "title": "Scale Down Fade",
  "description": "A restrained premium settle-in followed by scale-down fade readiness.",
  "tags": ["motion-primitive", "remocn-port", "typography"],
  "files": [
    {
      "path": "scale-down-fade.html",
      "target": "compositions/components/scale-down-fade.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [
    {
      "id": "words",
      "type": "string",
      "role": "content",
      "label": "Words",
      "description": "Words on screen, split on whitespace so each one gets its own stagger step.",
      "default": "Quiet confidence"
    },
    {
      "id": "overshoot",
      "type": "enum",
      "role": "motion",
      "label": "Overshoot",
      "description": "Scales how far above final size the words start before they settle.",
      "default": "standard",
      "options": [
        {
          "value": "subtle",
          "label": "Subtle"
        },
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "bold",
          "label": "Bold"
        }
      ]
    },
    {
      "id": "blur",
      "type": "enum",
      "role": "style",
      "label": "Blur",
      "description": "Scales the blur radius the timeline drives, from a light haze to a full smear.",
      "default": "standard",
      "options": [
        {
          "value": "soft",
          "label": "Soft"
        },
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "heavy",
          "label": "Heavy"
        }
      ]
    },
    {
      "id": "tone",
      "type": "enum",
      "role": "style",
      "label": "Tone",
      "description": "Word colour: ink for light frames, paper for dark ones, accent rides --brand.",
      "default": "ink",
      "options": [
        {
          "value": "ink",
          "label": "Ink"
        },
        {
          "value": "paper",
          "label": "Paper"
        },
        {
          "value": "accent",
          "label": "Accent"
        }
      ]
    }
  ],
  "preview": {
    "poster": "https://static.heygen.ai/hyperframes-oss/docs/images/catalog/components/scale-down-fade.png"
  }
}
