{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "input",
  "type": "hyperframes:component",
  "title": "Input",
  "description": "A video-safe text field with label, helper copy, focus state, and typed-value reveal",
  "tags": ["ui-primitive", "remocn-port", "input", "field"],
  "files": [
    {
      "path": "input.html",
      "target": "compositions/components/input.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [
    {
      "id": "label",
      "type": "string",
      "role": "content",
      "label": "Label",
      "description": "Field label, also used as the accessible name of the shell.",
      "default": "Project name"
    },
    {
      "id": "value",
      "type": "string",
      "role": "content",
      "label": "Value",
      "description": "Typed value revealed as the progress variable runs.",
      "default": "Launch recap"
    },
    {
      "id": "state",
      "type": "enum",
      "role": "style",
      "label": "State",
      "description": "Resting validation state: neutral, danger border, or dimmed.",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "invalid",
          "label": "Invalid"
        },
        {
          "value": "disabled",
          "label": "Disabled"
        }
      ]
    },
    {
      "id": "theme",
      "type": "enum",
      "role": "style",
      "label": "Theme",
      "description": "Operator Black dark surface or the light-frame token set.",
      "default": "dark",
      "options": [
        {
          "value": "dark",
          "label": "Dark"
        },
        {
          "value": "light",
          "label": "Light"
        }
      ]
    }
  ],
  "preview": {
    "poster": "https://static.heygen.ai/hyperframes-oss/docs/images/catalog/components/input.png"
  }
}
