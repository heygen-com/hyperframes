{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "rolling-number",
  "type": "hyperframes:component",
  "title": "Rolling Number",
  "description": "Odometer-style number places roll at their own speed and settle exactly.",
  "tags": ["motion-primitive", "remocn-port", "typography"],
  "files": [
    {
      "path": "rolling-number.html",
      "target": "compositions/components/rolling-number.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [
    {
      "id": "value",
      "type": "string",
      "role": "content",
      "label": "Value",
      "description": "The number to show. One place rolls in per character, so separators count too.",
      "default": "30,658",
      "maxLength": 24
    },
    {
      "id": "travel",
      "type": "enum",
      "role": "motion",
      "label": "Travel",
      "description": "Scales the drop the timeline drives, so each place covers a shorter or longer run in the same time.",
      "default": "standard",
      "options": [
        {
          "value": "close",
          "label": "Close"
        },
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "far",
          "label": "Far"
        }
      ]
    },
    {
      "id": "blur",
      "type": "enum",
      "role": "style",
      "label": "Blur",
      "description": "Scales the blur radius the timeline drives, from a light haze to a full smear.",
      "default": "standard",
      "options": [
        {
          "value": "soft",
          "label": "Soft"
        },
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "heavy",
          "label": "Heavy"
        }
      ]
    },
    {
      "id": "tone",
      "type": "enum",
      "role": "style",
      "label": "Tone",
      "description": "Digit colour: ink for light frames, paper for dark ones, accent rides --brand.",
      "default": "ink",
      "options": [
        {
          "value": "ink",
          "label": "Ink"
        },
        {
          "value": "paper",
          "label": "Paper"
        },
        {
          "value": "accent",
          "label": "Accent"
        }
      ]
    }
  ],
  "preview": {
    "poster": "https://static.heygen.ai/hyperframes-oss/docs/images/catalog/components/rolling-number.png"
  }
}
