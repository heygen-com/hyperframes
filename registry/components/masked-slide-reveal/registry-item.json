{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "masked-slide-reveal",
  "type": "hyperframes:component",
  "title": "Masked Slide Reveal",
  "description": "Words slide up out of an invisible horizontal mask one after another.",
  "tags": ["motion-primitive", "remocn-port", "typography"],
  "files": [
    {
      "path": "masked-slide-reveal.html",
      "target": "compositions/components/masked-slide-reveal.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [
    {
      "id": "words",
      "type": "string",
      "role": "content",
      "label": "Words",
      "description": "Whitespace separated words, one per revealed span. Up to twelve.",
      "default": "Agents compose scenes"
    },
    {
      "id": "size",
      "type": "number",
      "role": "style",
      "label": "Size",
      "description": "Type size of the words in pixels.",
      "default": 56,
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px"
    },
    {
      "id": "distance",
      "type": "enum",
      "role": "motion",
      "label": "Distance",
      "description": "Scales the slide offset, so the words cover a shorter or longer run in the same time.",
      "default": "standard",
      "options": [
        {
          "value": "close",
          "label": "Close"
        },
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "far",
          "label": "Far"
        }
      ]
    },
    {
      "id": "tone",
      "type": "enum",
      "role": "style",
      "label": "Tone",
      "description": "Word colour: ink for light frames, paper for dark ones, accent rides --brand.",
      "default": "ink",
      "options": [
        {
          "value": "ink",
          "label": "Ink"
        },
        {
          "value": "paper",
          "label": "Paper"
        },
        {
          "value": "accent",
          "label": "Accent"
        }
      ]
    }
  ],
  "preview": {
    "poster": "https://static.heygen.ai/hyperframes-oss/docs/images/catalog/components/masked-slide-reveal.png"
  }
}
