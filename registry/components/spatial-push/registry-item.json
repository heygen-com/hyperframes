{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "spatial-push",
  "type": "hyperframes:component",
  "title": "Spatial Push",
  "description": "A physical depth transition that presses the old scene backward.",
  "tags": ["transition-primitive", "remocn-port"],
  "files": [
    {
      "path": "spatial-push.html",
      "target": "compositions/components/spatial-push.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [
    {
      "id": "direction",
      "type": "enum",
      "role": "motion",
      "label": "Direction",
      "description": "Which way the push runs. right wipes the new scene in from the left edge, left mirrors the whole move.",
      "default": "right",
      "options": [
        {
          "value": "right",
          "label": "Rightward"
        },
        {
          "value": "left",
          "label": "Leftward"
        }
      ]
    },
    {
      "id": "depth",
      "type": "enum",
      "role": "motion",
      "label": "Depth",
      "description": "Scales how hard the old scene is pressed backward: its shove, its shrink and its blur together.",
      "default": "standard",
      "options": [
        {
          "value": "subtle",
          "label": "Subtle"
        },
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "deep",
          "label": "Deep"
        }
      ]
    },
    {
      "id": "sheen",
      "type": "enum",
      "role": "style",
      "label": "Sheen",
      "description": "Strength of the white light sweep that crosses the seam, from removed entirely to full white.",
      "default": "standard",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "soft",
          "label": "Soft"
        },
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "bright",
          "label": "Bright"
        }
      ]
    },
    {
      "id": "accent",
      "type": "enum",
      "role": "style",
      "label": "Accent",
      "description": "Incoming scene gradient. blue defers to the --hf-accent token so a retinted host retints the scene.",
      "default": "blue",
      "options": [
        {
          "value": "blue",
          "label": "Blue"
        },
        {
          "value": "violet",
          "label": "Violet"
        },
        {
          "value": "green",
          "label": "Green"
        }
      ]
    }
  ],
  "preview": {
    "poster": "https://static.heygen.ai/hyperframes-oss/docs/images/catalog/components/spatial-push.png"
  }
}
