{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "calendar",
  "type": "hyperframes:component",
  "title": "Calendar",
  "description": "A compact date grid with a recessed selected day and deterministic reveal",
  "tags": ["ui-primitive", "remocn-port", "calendar", "date"],
  "files": [
    {
      "path": "calendar.html",
      "target": "compositions/components/calendar.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [
    {
      "id": "monthLabel",
      "type": "string",
      "role": "content",
      "label": "Month label",
      "description": "Heading above the date grid, also used as the accessible name.",
      "default": "June 2026"
    },
    {
      "id": "density",
      "type": "enum",
      "role": "layout",
      "label": "Density",
      "description": "Cell height, grid gap, and card width of the date row.",
      "default": "standard",
      "options": [
        {
          "value": "compact",
          "label": "Compact"
        },
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "roomy",
          "label": "Roomy"
        }
      ]
    },
    {
      "id": "accent",
      "type": "enum",
      "role": "style",
      "label": "Accent",
      "description": "Colour of the underline beneath the selected day.",
      "default": "green",
      "options": [
        {
          "value": "green",
          "label": "Green"
        },
        {
          "value": "blue",
          "label": "Blue"
        },
        {
          "value": "violet",
          "label": "Violet"
        }
      ]
    },
    {
      "id": "theme",
      "type": "enum",
      "role": "style",
      "label": "Theme",
      "description": "Operator Black dark surface or the light-frame token set.",
      "default": "dark",
      "options": [
        {
          "value": "dark",
          "label": "Dark"
        },
        {
          "value": "light",
          "label": "Light"
        }
      ]
    }
  ],
  "preview": {
    "poster": "https://static.heygen.ai/hyperframes-oss/docs/images/catalog/components/calendar.png"
  }
}
