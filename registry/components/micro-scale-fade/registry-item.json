{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "micro-scale-fade",
  "type": "hyperframes:component",
  "title": "Micro Scale Fade",
  "description": "A tiny scale-and-opacity transition for UI state changes.",
  "tags": ["transition-primitive", "remocn-port"],
  "files": [
    {
      "path": "micro-scale-fade.html",
      "target": "compositions/components/micro-scale-fade.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [
    {
      "id": "fromLabel",
      "type": "string",
      "role": "content",
      "label": "From label",
      "description": "Wording on the outgoing scene.",
      "default": "Before"
    },
    {
      "id": "toLabel",
      "type": "string",
      "role": "content",
      "label": "To label",
      "description": "Wording on the incoming scene.",
      "default": "Micro Scale Fade"
    },
    {
      "id": "accent",
      "type": "enum",
      "role": "style",
      "label": "Accent",
      "description": "Gradient the incoming scene is painted with.",
      "default": "blue",
      "options": [
        {
          "value": "blue",
          "label": "Blue"
        },
        {
          "value": "green",
          "label": "Green"
        },
        {
          "value": "ember",
          "label": "Ember"
        }
      ]
    },
    {
      "id": "travel",
      "type": "enum",
      "role": "motion",
      "label": "Travel",
      "description": "Scales the sideways run both scenes cover during the wipe.",
      "default": "standard",
      "options": [
        {
          "value": "close",
          "label": "Close"
        },
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "far",
          "label": "Far"
        }
      ]
    }
  ],
  "preview": {
    "poster": "https://static.heygen.ai/hyperframes-oss/docs/images/catalog/components/micro-scale-fade.png"
  }
}
