{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "input-otp",
  "type": "hyperframes:component",
  "title": "Input OTP",
  "description": "A segmented one-time-code field with tabular digits and an active slot",
  "tags": ["ui-primitive", "remocn-port", "input-otp", "field"],
  "files": [
    {
      "path": "input-otp.html",
      "target": "compositions/components/input-otp.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [
    {
      "id": "code",
      "type": "string",
      "role": "content",
      "label": "Code",
      "description": "Digits already entered. Non-digits are dropped and the next empty slot becomes active.",
      "default": "428"
    },
    {
      "id": "length",
      "type": "number",
      "role": "layout",
      "label": "Length",
      "description": "How many slots the code field shows.",
      "default": 4,
      "min": 4,
      "max": 8,
      "step": 1
    },
    {
      "id": "accent",
      "type": "enum",
      "role": "style",
      "label": "Accent",
      "description": "Accent token family used for the active slot border, ring and caret.",
      "default": "green",
      "options": [
        {
          "value": "green",
          "label": "Green"
        },
        {
          "value": "blue",
          "label": "Blue"
        },
        {
          "value": "amber",
          "label": "Amber"
        },
        {
          "value": "violet",
          "label": "Violet"
        }
      ]
    },
    {
      "id": "theme",
      "type": "enum",
      "role": "style",
      "label": "Theme",
      "description": "Operator Black dark surface or the light-frame token set.",
      "default": "dark",
      "options": [
        {
          "value": "dark",
          "label": "Dark"
        },
        {
          "value": "light",
          "label": "Light"
        }
      ]
    }
  ],
  "preview": {
    "poster": "https://static.heygen.ai/hyperframes-oss/docs/images/catalog/components/input-otp.png"
  }
}
