{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "short-slide-down",
  "type": "hyperframes:component",
  "title": "Short Slide Down",
  "description": "New words drop from above and push the stack downward into a locked composition.",
  "tags": ["motion-primitive", "remocn-port", "typography"],
  "files": [
    {
      "path": "short-slide-down.html",
      "target": "compositions/components/short-slide-down.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [
    {
      "id": "direction",
      "type": "enum",
      "role": "motion",
      "label": "Direction",
      "description": "Where the lines travel in from: up rises from below the baseline, down settles from above, left and right slide in flat with no vertical leg.",
      "default": "up",
      "options": [
        {
          "value": "up",
          "label": "Up"
        },
        {
          "value": "down",
          "label": "Down"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "id": "distance",
      "type": "enum",
      "role": "motion",
      "label": "Distance",
      "description": "Scales both offsets, so the lines cover a shorter or longer run in the same time.",
      "default": "standard",
      "options": [
        {
          "value": "close",
          "label": "Close"
        },
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "far",
          "label": "Far"
        }
      ]
    },
    {
      "id": "blur",
      "type": "enum",
      "role": "style",
      "label": "Blur",
      "description": "Scales the blur radius the timeline drives, from a light haze to a full smear.",
      "default": "standard",
      "options": [
        {
          "value": "soft",
          "label": "Soft"
        },
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "heavy",
          "label": "Heavy"
        }
      ]
    },
    {
      "id": "tone",
      "type": "enum",
      "role": "style",
      "label": "Tone",
      "description": "Line colour: ink for light frames, paper for dark ones, accent rides --brand.",
      "default": "ink",
      "options": [
        {
          "value": "ink",
          "label": "Ink"
        },
        {
          "value": "paper",
          "label": "Paper"
        },
        {
          "value": "accent",
          "label": "Accent"
        }
      ]
    }
  ],
  "preview": {
    "poster": "https://static.heygen.ai/hyperframes-oss/docs/images/catalog/components/short-slide-down.png"
  }
}
