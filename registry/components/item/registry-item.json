{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "item",
  "type": "hyperframes:component",
  "title": "Item",
  "description": "A border-led interactive list row with neutral monogram, compact metadata, and deterministic hover state",
  "tags": ["ui-primitive", "remocn-port", "item", "list"],
  "files": [
    {
      "path": "item.html",
      "target": "compositions/components/item.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [
    {
      "id": "title",
      "type": "string",
      "role": "content",
      "label": "Title",
      "description": "Row title. Its first letter also becomes the monogram.",
      "default": "Audio synced"
    },
    {
      "id": "meta",
      "type": "string",
      "role": "content",
      "label": "Meta",
      "description": "Secondary line under the title.",
      "default": "Beat grid detected"
    },
    {
      "id": "density",
      "type": "enum",
      "role": "layout",
      "label": "Density",
      "description": "Row height, padding and column gap.",
      "default": "comfortable",
      "options": [
        {
          "value": "comfortable",
          "label": "Comfortable"
        },
        {
          "value": "compact",
          "label": "Compact"
        }
      ]
    },
    {
      "id": "theme",
      "type": "enum",
      "role": "style",
      "label": "Theme",
      "description": "Operator Black dark surface or the light-frame token set.",
      "default": "dark",
      "options": [
        {
          "value": "dark",
          "label": "Dark"
        },
        {
          "value": "light",
          "label": "Light"
        }
      ]
    }
  ],
  "preview": {
    "poster": "https://static.heygen.ai/hyperframes-oss/docs/images/catalog/components/item.png"
  }
}
