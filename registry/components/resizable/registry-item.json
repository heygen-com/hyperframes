{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "resizable",
  "type": "hyperframes:component",
  "title": "Resizable",
  "description": "An accessible split-pane primitive with structural edges, a keyboard-focusable handle, and deterministic resizing",
  "tags": ["ui-primitive", "remocn-port", "resizable", "layout"],
  "files": [
    {
      "path": "resizable.html",
      "target": "compositions/components/resizable.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [
    {
      "id": "split",
      "type": "enum",
      "role": "layout",
      "label": "Split",
      "description": "Scales the driven pane divide, so the primary pane keeps a narrower or wider share of the frame at every point of the drag.",
      "default": "standard",
      "options": [
        {
          "value": "inspector",
          "label": "Inspector heavy"
        },
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "preview",
          "label": "Preview heavy"
        }
      ]
    },
    {
      "id": "size",
      "type": "enum",
      "role": "layout",
      "label": "Size",
      "description": "Overall footprint of the split pane on the frame.",
      "default": "standard",
      "options": [
        {
          "value": "compact",
          "label": "Compact"
        },
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ]
    },
    {
      "id": "panes",
      "type": "string",
      "role": "content",
      "label": "Pane labels",
      "description": "Comma separated names for the primary and secondary pane, in order.",
      "default": "Preview, Inspector",
      "maxLength": 80
    }
  ],
  "preview": {
    "poster": "https://static.heygen.ai/hyperframes-oss/docs/images/catalog/components/resizable.png"
  }
}
