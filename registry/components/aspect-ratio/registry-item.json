{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "aspect-ratio",
  "type": "hyperframes:component",
  "title": "Aspect Ratio",
  "description": "A matte aspect-ratio frame for media and previews with a compact technical dimension label",
  "tags": ["ui-primitive", "remocn-port", "aspect-ratio", "layout"],
  "files": [
    {
      "path": "aspect-ratio.html",
      "target": "compositions/components/aspect-ratio.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [
    {
      "id": "ratio",
      "type": "enum",
      "role": "style",
      "label": "Ratio",
      "description": "Frame shape, mirrored into the dimension label.",
      "default": "16:9",
      "options": [
        {
          "value": "16:9",
          "label": "16:9"
        },
        {
          "value": "4:3",
          "label": "4:3"
        },
        {
          "value": "1:1",
          "label": "1:1"
        },
        {
          "value": "9:16",
          "label": "9:16"
        },
        {
          "value": "21:9",
          "label": "21:9"
        }
      ]
    },
    {
      "id": "size",
      "type": "enum",
      "role": "style",
      "label": "Size",
      "description": "Maximum frame width before it shrinks to the host box.",
      "default": "standard",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ]
    },
    {
      "id": "fill",
      "type": "enum",
      "role": "style",
      "label": "Fill",
      "description": "Frame interior: matte is the inset surface, canvas is the deeper page colour, outline is a dashed empty placeholder.",
      "default": "matte",
      "options": [
        {
          "value": "matte",
          "label": "Matte"
        },
        {
          "value": "canvas",
          "label": "Canvas"
        },
        {
          "value": "outline",
          "label": "Outline"
        }
      ]
    }
  ],
  "preview": {
    "poster": "https://static.heygen.ai/hyperframes-oss/docs/images/catalog/components/aspect-ratio.png"
  }
}
