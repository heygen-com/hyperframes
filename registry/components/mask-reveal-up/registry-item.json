{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "mask-reveal-up",
  "type": "hyperframes:component",
  "title": "Mask Reveal Up",
  "description": "Lines reveal upward through a tight mask with compact stagger.",
  "tags": ["motion-primitive", "remocn-port", "typography"],
  "files": [
    {
      "path": "mask-reveal-up.html",
      "target": "compositions/components/mask-reveal-up.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [
    {
      "id": "origin",
      "type": "enum",
      "role": "motion",
      "label": "Origin",
      "description": "Which side the lines swing in from before they settle.",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "straight",
          "label": "Straight"
        }
      ]
    },
    {
      "id": "distance",
      "type": "enum",
      "role": "motion",
      "label": "Distance",
      "description": "Scales the travel offsets, so the lines cover a shorter or longer run in the same time.",
      "default": "standard",
      "options": [
        {
          "value": "close",
          "label": "Close"
        },
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "far",
          "label": "Far"
        }
      ]
    },
    {
      "id": "line_gap",
      "type": "enum",
      "role": "layout",
      "label": "Line gap",
      "description": "Vertical space between the stacked lines.",
      "default": "standard",
      "options": [
        {
          "value": "tight",
          "label": "Tight"
        },
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "loose",
          "label": "Loose"
        }
      ]
    },
    {
      "id": "tone",
      "type": "enum",
      "role": "style",
      "label": "Tone",
      "description": "Line colour: ink for light frames, paper for dark ones, accent rides --brand.",
      "default": "ink",
      "options": [
        {
          "value": "ink",
          "label": "Ink"
        },
        {
          "value": "paper",
          "label": "Paper"
        },
        {
          "value": "accent",
          "label": "Accent"
        }
      ]
    }
  ],
  "preview": {
    "poster": "https://static.heygen.ai/hyperframes-oss/docs/images/catalog/components/mask-reveal-up.png"
  }
}
