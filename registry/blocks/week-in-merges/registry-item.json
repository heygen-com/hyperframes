      "id": "title",
      "type": "string",
      "label": "Title",
      "default": "Pull requests merged this week"
    },
    {
      "id": "period",
      "type": "string",
      "label": "Period",
      "default": "1 September - 7 September 2026 · America/Los_Angeles"
    },
    {
      "id": "total",
      "type": "string",
      "label": "Total",
      "default": "12 PRs"
    },
    {
      "id": "footer",
      "type": "string",
      "label": "Footer",
