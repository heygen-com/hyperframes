# HyperFrames distributed renderer — reference Dockerfile for non-Lambda runtimes.
#
# This image bakes Node 22, bun, chrome-headless-shell, ffmpeg, and the
# `@hyperframes/producer/distributed` primitives. One image runs the
# Plan / RenderChunk / Assemble activities for any non-Lambda orchestrator:
#
#   - Kubernetes Jobs (one Job per chunk, Argo Workflows on top)
#   - AWS ECS Fargate (one task per chunk)
#   - Google Cloud Run Jobs
#   - Azure Container Apps Jobs
#   - Plain `docker run` on a beefy VM
#
# We deliberately do NOT publish this image to a registry. The OSS contract
# is that adopters build it themselves — that way the Chrome / ffmpeg /
# producer versions are pinned to the source checkout they audited, not a
# floating tag we'd have to keep in sync with every release.
#
# Build from the repo root:
#
#   docker build -t hyperframes-chunk-runner:local -f examples/k8s-jobs/Dockerfile.example .
#
# Run a chunk worker (an orchestrator script wraps this entry point):
#
#   docker run --rm \
#     -v /tmp/hyperframes:/tmp/hyperframes \
#     -w /app/packages/aws-lambda \
#     hyperframes-chunk-runner:local \
#     bun -e 'const { renderChunk } = await import("@hyperframes/producer/distributed"); await renderChunk(...)'
#
# Lambda adopters use `packages/aws-lambda/dist/handler.zip` instead;
# this Dockerfile is the K8s / Cloud Run / ECS path.

# ── Base ─────────────────────────────────────────────────────────────────────
# Debian bookworm-slim because the chrome-headless-shell dynamic-library set
# matches what we use in CI. Amazon Linux 2023 also works (Lambda's base
# image) but is harder to debug locally.
FROM node:22-bookworm-slim AS base

# ── System deps ──────────────────────────────────────────────────────────────
# - libfontconfig / libfreetype / fonts-*: Chrome text shaping, the font set
#   packages/gcp-cloud-run/Dockerfile uses (CJK and emoji included)
# - chromium-style ABI deps (the minimum set chrome-headless-shell needs):
#   libnss3, libatk-bridge2.0, libdrm2, libgbm1, libxshmfence1, libxkbcommon0,
#   libxcomposite1, libxdamage1, libxfixes3, libxrandr2, libasound2,
#   libpangocairo-1.0-0
# - tini: clean PID 1 for container teardown signals (Cloud Run / Fargate
#   send SIGTERM at the 10-min grace boundary).
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates \
      fonts-dejavu-core \
      fonts-freefont-ttf \
      fonts-liberation \
      fonts-noto-cjk \
      fonts-noto-color-emoji \
      fonts-noto-core \
      fonts-noto-extra \
      fonts-noto-ui-core \
      libasound2 \
      libatk-bridge2.0-0 \
      libatk1.0-0 \
      libc6 \
      libcairo2 \
      libcups2 \
      libdbus-1-3 \
      libdrm2 \
      libfontconfig1 \
      libfreetype6 \
      libgbm1 \
      libglib2.0-0 \
      libnspr4 \
      libnss3 \
      libpango-1.0-0 \
      libpangocairo-1.0-0 \
      libxcomposite1 \
      libxdamage1 \
      libxfixes3 \
      libxkbcommon0 \
      libxrandr2 \
      libxshmfence1 \
      tini \
      tzdata \
      wget \
      xz-utils \
    && rm -rf /var/lib/apt/lists/*

# ── FFmpeg (pinned) ──────────────────────────────────────────────────────────
# The producer's encode + audio mix. One pinned static build (BtbN n8.0.1)
# instead of Debian's apt ffmpeg, so regression baselines and the shipped
# images use the same FFmpeg version.
# Bump the URL and sha256 together, and keep in sync with the other Dockerfiles
# and .github/actions/install-ffmpeg-linux/action.yml.
ARG TARGETARCH
ARG FFMPEG_RELEASE=https://github.com/BtbN/FFmpeg-Builds/releases/download/autobuild-2026-02-28-12-59
ARG FFMPEG_BUILD=ffmpeg-n8.0.1-66-g27b8d1a017
ARG FFMPEG_SHA256_AMD64=26d2ecd0cefba99f9d1ea92252a3a4f743a58df4c1c3cf9f8bbaaa40b1fca5b0
ARG FFMPEG_SHA256_ARM64=d72cc324cb65dd92a9ffe699cc95ccbacfef4def8d3ad9fe2b5164a6a71b9595
RUN case "$TARGETARCH" in \
      amd64) FF_ARCH=linux64; FF_SHA256="$FFMPEG_SHA256_AMD64" ;; \
      arm64) FF_ARCH=linuxarm64; FF_SHA256="$FFMPEG_SHA256_ARM64" ;; \
      *) echo "unsupported TARGETARCH '$TARGETARCH'" >&2; exit 1 ;; \
    esac \
    && wget -q -O /tmp/ffmpeg.tar.xz "$FFMPEG_RELEASE/$FFMPEG_BUILD-$FF_ARCH-gpl-8.0.tar.xz" \
    && echo "$FF_SHA256  /tmp/ffmpeg.tar.xz" | sha256sum -c - \
    && tar -xJf /tmp/ffmpeg.tar.xz -C /usr/local/bin --strip-components=2 --wildcards '*/bin/ffmpeg' '*/bin/ffprobe' \
    && rm /tmp/ffmpeg.tar.xz \
    && ffmpeg -version | grep -F "ffmpeg version ${FFMPEG_BUILD#ffmpeg-}" \
    && ffprobe -version | grep -F "ffprobe version ${FFMPEG_BUILD#ffmpeg-}"

# ── Chrome ───────────────────────────────────────────────────────────────────
# Use `@puppeteer/browsers` to fetch the chrome-headless-shell version
# packages/gcp-cloud-run/Dockerfile pins.
ENV CHROME_HEADLESS_SHELL_VERSION=152.0.7977.30
ENV CHROME_DIR=/opt/chrome

RUN mkdir -p "$CHROME_DIR" && \
    npm install --global @puppeteer/browsers@2.13.0 && \
    npx @puppeteer/browsers install "chrome-headless-shell@${CHROME_HEADLESS_SHELL_VERSION}" \
      --path "$CHROME_DIR" && \
    npm uninstall --global @puppeteer/browsers && \
    rm -rf /root/.npm

ENV PRODUCER_HEADLESS_SHELL_PATH=${CHROME_DIR}/chrome-headless-shell/linux-${CHROME_HEADLESS_SHELL_VERSION}/chrome-headless-shell-linux64/chrome-headless-shell

# ── HyperFrames ──────────────────────────────────────────────────────────────
# Producer code runs under bun, as in packages/gcp-cloud-run/Dockerfile: its
# workspace exports point at TypeScript source. Run it from a workspace that
# depends on it (e.g. packages/aws-lambda); the root package does not.
WORKDIR /app
COPY package.json bun.lock ./
COPY packages/aws-lambda/package.json packages/aws-lambda/
COPY packages/core/package.json packages/core/
COPY packages/engine/package.json packages/engine/
COPY packages/lint/package.json packages/lint/
COPY packages/parsers/package.json packages/parsers/
COPY packages/player/package.json packages/player/
COPY packages/producer/package.json packages/producer/
COPY packages/studio-server/package.json packages/studio-server/

RUN npm install --global bun@1.4.2 && \
    bun install --frozen-lockfile

# Bring in the source. Core's build generates files its source imports
# (e.g. runtime-inline); the other packages run from source under bun. The
# build also runs the shared post-emit import rewrite from the repo root.
COPY scripts/rewrite-relative-import-extensions.mjs ./scripts/rewrite-relative-import-extensions.mjs
COPY packages/core ./packages/core
COPY packages/engine ./packages/engine
COPY packages/lint ./packages/lint
COPY packages/parsers ./packages/parsers
COPY packages/producer ./packages/producer
COPY packages/studio-server ./packages/studio-server
RUN bun run --cwd packages/core build

# ── Runtime ──────────────────────────────────────────────────────────────────
ENTRYPOINT ["/usr/bin/tini", "--"]
# Default CMD prints the producer version + Chrome path; orchestrators
# typically override CMD with their per-chunk activity invocation.
CMD ["node", "-e", "console.log(JSON.stringify({producerVersion: require('./packages/producer/package.json').version, chromePath: process.env.PRODUCER_HEADLESS_SHELL_PATH}))"]
