{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "plugins": ["react", "react-hooks", "typescript"],
  "ignorePatterns": [
    ".scratch/",
    "dist/",
    "coverage/",
    "node_modules/",
    "playground/",
    "packages/producer/tests/**/src/vendor/**",
    "docs/public/catalog/",
    "registry/blocks/**/lib/*.iife.js",
    "registry/blocks/{glass-shard-title,code-slice-hero,cuboid-carousel,frost-sequence-camera-orbit,orbit-card}/**/*.{js,mjs}",
    "registry/blocks/frost-sequence-camera-orbit/source/**",
    "registry/examples/path-traced-3d/assets/vendor/*.min.js",
    "chrome/",
    "packages/cli/src/media-use/lib/svg-sanitize.mjs",
    "skills/media-use/audio/scripts/lib/audio-carve.mjs",
    "packages/cli/src/audio/scripts/lib/audio-carve.mjs"
  ],
  "overrides": [
    {
      "files": [
        "packages/cli/src/capture/**/*.ts",
        "packages/cli/src/registry/**/*.ts",
        "packages/cli/src/templates/**/*.ts",
        "packages/cli/src/telemetry/**/*.ts",
        "packages/engine/src/services/browserManager.ts",
        "packages/engine/src/services/frameCapture.ts",
        "packages/engine/src/services/parallelCoordinator.ts"
      ],
      "excludeFiles": ["**/*.test.ts", "**/*.test.tsx", "packages/cli/src/telemetry/feedback.ts"],
      "rules": {
        "no-console": [
          "error",
          {
            "allow": ["error", "warn"]
          }
        ]
      }
    },
    {
      "files": ["docs/snippets/**/*.jsx", "docs/snippets/**/*.tsx"],
      "globals": {
        "CodeBlock": "readonly"
      },
      "rules": {
        "react-hooks/rules-of-hooks": "error",
        "react-hooks/exhaustive-deps": "warn"
      }
    },
    {
      "files": ["packages/studio/src/**/*.ts", "packages/studio/src/**/*.tsx"],
      "excludeFiles": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*TestUtils.ts",
        "**/*TestUtils.tsx",
        "**/*TestHarness.ts",
        "**/*TestHarness.tsx",
        "packages/studio/src/utils/studioApiFetch.ts"
      ],
      "rules": {
        "no-restricted-globals": [
          "error",
          {
            "name": "fetch",
            "message": "Use studioApiFetch (utils/studioApiFetch.ts): it keeps Studio's requests off the preview media's sockets."
          }
        ],
        "no-restricted-properties": [
          "error",
          {
            "object": "window",
            "property": "fetch",
            "message": "Use studioApiFetch (utils/studioApiFetch.ts): it keeps Studio's requests off the preview media's sockets."
          },
          {
            "object": "globalThis",
            "property": "fetch",
            "message": "Use studioApiFetch (utils/studioApiFetch.ts): it keeps Studio's requests off the preview media's sockets."
          },
          {
            "object": "self",
            "property": "fetch",
            "message": "Use studioApiFetch (utils/studioApiFetch.ts): it keeps Studio's requests off the preview media's sockets."
          },
          {
            "object": "postcss",
            "property": "parse",
            "message": "Parse CSS with parseCss from @hyperframes/parsers/postcss: it never opens the file a sourceMappingURL comment in the CSS names."
          }
        ]
      }
    },
    {
      "files": ["packages/*/src/**/*.ts"],
      "excludeFiles": [
        "**/*.test.ts",
        "packages/parsers/src/linkedom.ts",
        "packages/parsers/src/postcss.ts",
        "packages/cli/src/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "linkedom",
                "message": "Import from @hyperframes/parsers/linkedom: it writes <title> and <textarea> text so it can't close its element."
              },
              {
                "name": "postcss",
                "importNames": ["parse"],
                "message": "Parse CSS with parseCss from @hyperframes/parsers/postcss: it never opens the file a sourceMappingURL comment in the CSS names."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/cli/src/**/*.ts"],
      "excludeFiles": [
        "**/*.test.ts",
        "packages/cli/src/utils/defineCommand.ts",
        "packages/cli/src/ui/prompts.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "citty",
                "importNames": ["defineCommand"],
                "message": "Define commands with defineCommand from packages/cli/src/utils/defineCommand.ts so the shared guards and the agent-mode contract test cover them."
              },
              {
                "name": "@clack/prompts",
                "message": "Import prompts and spinners from packages/cli/src/ui/prompts.ts: it refuses to prompt when nobody can answer."
              },
              {
                "name": "linkedom",
                "message": "Import from @hyperframes/parsers/linkedom: it writes <title> and <textarea> text so it can't close its element."
              },
              {
                "name": "postcss",
                "importNames": ["parse"],
                "message": "Parse CSS with parseCss from @hyperframes/parsers/postcss: it never opens the file a sourceMappingURL comment in the CSS names."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "packages/*/src/**/*.ts",
        "packages/*/src/**/*.tsx",
        "packages/*/src/**/*.mts",
        "packages/*/src/**/*.cts",
        "packages/*/src/**/*.js",
        "packages/*/src/**/*.mjs",
        "packages/*/src/**/*.cjs"
      ],
      "excludeFiles": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.test.mts",
        "**/*.test.cts",
        "**/*.test.js",
        "**/*.test.mjs",
        "**/*.test.cjs",
        "packages/studio/src/**/*.ts",
        "packages/studio/src/**/*.tsx",
        "packages/parsers/src/postcss.ts"
      ],
      "rules": {
        "no-restricted-properties": [
          "error",
          {
            "object": "postcss",
            "property": "parse",
            "message": "Parse CSS with parseCss from @hyperframes/parsers/postcss: it never opens the file a sourceMappingURL comment in the CSS names."
          }
        ]
      }
    },
    {
      "files": [
        "packages/*/src/**/*.tsx",
        "packages/*/src/**/*.mts",
        "packages/*/src/**/*.cts",
        "packages/*/src/**/*.js",
        "packages/*/src/**/*.mjs",
        "packages/*/src/**/*.cjs"
      ],
      "excludeFiles": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.test.mts",
        "**/*.test.cts",
        "**/*.test.js",
        "**/*.test.mjs",
        "**/*.test.cjs"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "postcss",
                "importNames": ["parse"],
                "message": "Parse CSS with parseCss from @hyperframes/parsers/postcss: it never opens the file a sourceMappingURL comment in the CSS names."
              }
            ]
          }
        ]
      }
    }
  ]
}
