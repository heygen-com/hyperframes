{"html":"<!doctype html>\n<!--\n  swipe-rail demo. This standalone composition mounts swipe-rail.html through\n  data-composition-src. Non-default values prove that all three variables\n  flow through the mount while the primitive remains sized by its host box.\n-->\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=1920, height=1080\" />\n    <title>Swipe Rail Demo</title>\n    <style>\n      * {\n        margin: 0;\n        padding: 0;\n        box-sizing: border-box;\n      }\n\n      html,\n      body {\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n        background: #0b0c0e;\n      }\n\n      #root {\n        position: relative;\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n        background: radial-gradient(ellipse at 50% 45%, #20232a 0%, #0b0c0e 72%);\n      }\n\n      .mount-card {\n        width: 76%;\n        height: 64%;\n        left: 12%;\n        top: 18%;\n        container-type: size;\n        overflow: hidden;\n        border: 2px solid rgba(148, 163, 184, 0.24);\n        border-radius: 34px;\n        background: #111827;\n        box-shadow: 0 44px 110px rgba(0, 0, 0, 0.48);\n      }\n    </style>\n  </head>\n  <body>\n    <div\n      id=\"root\"\n      data-composition-id=\"swipe-rail-demo\"\n      data-start=\"0\"\n      data-width=\"1920\"\n      data-height=\"1080\"\n      data-duration=\"4\"\n      data-fps=\"30\"\n    >\n      <div\n        id=\"swipe-rail-mount\"\n        class=\"mount-card clip\"\n        data-composition-id=\"swipe-rail\"\n        data-composition-src=\"data:text/html;base64,\"\n       \n        data-start=\"0\"\n        data-duration=\"4\"\n        data-track-index=\"0\"\n        data-width=\"1460\"\n        data-height=\"691\"\n      ></div>\n    </div>\n\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n    <script>\n      window.__timelines = window.__timelines || {};\n      window.__timelines[\"swipe-rail-demo\"] = gsap.timeline({ paused: true });\n    </script>\n  </body>\n</html>\n"}