{"html":"<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=1920, height=1080\" />\n    <title>Banner Push-In</title>\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n    <style>\n      html,\n      body {\n        margin: 0;\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n      }\n      body {\n        background: #0a0a0a;\n      }\n      .hf-ui-demo-canvas {\n        position: relative;\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n        background: linear-gradient(172deg, #efe9e0 0%, #e2dbcf 100%);\n        font-family:\n          ui-sans-serif,\n          -apple-system,\n          BlinkMacSystemFont,\n          \"Segoe UI\",\n          sans-serif;\n      }\n      .hf-ui-demo-canvas::before {\n        content: \"\";\n        position: absolute;\n        left: 220px;\n        top: -180px;\n        width: 720px;\n        height: 720px;\n        border-radius: 50%;\n        background: radial-gradient(circle, rgba(60, 230, 172, 0.24) 0%, rgba(60, 230, 172, 0) 68%);\n      }\n      .hf-bpi-stack {\n        position: absolute;\n        left: 555px;\n        top: 700px;\n        width: 810px;\n      }\n      .hf-bpi-banner {\n        position: absolute;\n        left: 0;\n        top: 0;\n        width: 810px;\n        height: 176px;\n        border-radius: 26px;\n        background: rgba(249, 245, 240, 0.82);\n        box-shadow: 0 10px 26px rgba(20, 16, 10, 0.18);\n        color: #1c1c1e;\n      }\n      .hf-bpi-icon {\n        position: absolute;\n        left: 23px;\n        top: 38px;\n        width: 100px;\n        height: 100px;\n        border-radius: 24px;\n        background: linear-gradient(180deg, #5ae458 0%, #1fc83f 100%);\n      }\n      .hf-bpi-icon svg {\n        position: absolute;\n        left: 18px;\n        top: 20px;\n      }\n      .hf-bpi-title {\n        position: absolute;\n        left: 148px;\n        top: 37px;\n        font-size: 35px;\n        font-weight: 700;\n        letter-spacing: 0.25px;\n      }\n      .hf-bpi-subtitle {\n        position: absolute;\n        left: 148px;\n        top: 85px;\n        font-size: 33px;\n        font-weight: 400;\n        color: #464040;\n        letter-spacing: -0.75px;\n      }\n      .hf-bpi-meta {\n        position: absolute;\n        right: 26px;\n        top: 32px;\n        font-size: 22px;\n        color: #6b6562;\n        letter-spacing: 1px;\n      }\n    </style>\n  </head>\n  <body>\n    <div\n      id=\"hf-bpi-demo-root\"\n      class=\"hf-ui-demo-canvas\"\n      data-composition-id=\"banner-push-in-demo\"\n      data-start=\"0\"\n      data-width=\"1920\"\n      data-height=\"1080\"\n      data-duration=\"6\"\n    >\n      <section class=\"clip hf-bpi-stack\" data-start=\"0\" data-duration=\"6\" data-track-index=\"1\">\n        <div class=\"hf-bpi-banner\" id=\"hf-bpi-demo-1\">\n          <div class=\"hf-bpi-icon\">\n            <svg width=\"64\" height=\"60\" viewBox=\"0 0 64 60\" fill=\"none\">\n              <path\n                d=\"M32 2 C15 2 2 13 2 27 c0 8 4.6 15 12 19.6 -0.7 3.6 -2.9 7.4 -6.4 10.2 5.8 -0.6 10.9 -2.8 14.6 -5.5 3.1 0.8 6.4 1.2 9.8 1.2 17 0 30 -11 30 -25.5 S49 2 32 2 Z\"\n                fill=\"#fff\"\n              />\n            </svg>\n          </div>\n          <div class=\"hf-bpi-title\">New render</div>\n          <div class=\"hf-bpi-subtitle\">Launch video is ready.</div>\n          <div class=\"hf-bpi-meta\">NOW</div>\n        </div>\n        <div class=\"hf-bpi-banner\" id=\"hf-bpi-demo-2\">\n          <div class=\"hf-bpi-icon\">\n            <svg width=\"64\" height=\"60\" viewBox=\"0 0 64 60\" fill=\"none\">\n              <path\n                d=\"M32 2 C15 2 2 13 2 27 c0 8 4.6 15 12 19.6 -0.7 3.6 -2.9 7.4 -6.4 10.2 5.8 -0.6 10.9 -2.8 14.6 -5.5 3.1 0.8 6.4 1.2 9.8 1.2 17 0 30 -11 30 -25.5 S49 2 32 2 Z\"\n                fill=\"#fff\"\n              />\n            </svg>\n          </div>\n          <div class=\"hf-bpi-title\">New render</div>\n          <div class=\"hf-bpi-subtitle\">All checks passed.</div>\n          <div class=\"hf-bpi-meta\">NOW</div>\n        </div>\n        <div class=\"hf-bpi-banner\" id=\"hf-bpi-demo-3\">\n          <div class=\"hf-bpi-icon\">\n            <svg width=\"64\" height=\"60\" viewBox=\"0 0 64 60\" fill=\"none\">\n              <path\n                d=\"M32 2 C15 2 2 13 2 27 c0 8 4.6 15 12 19.6 -0.7 3.6 -2.9 7.4 -6.4 10.2 5.8 -0.6 10.9 -2.8 14.6 -5.5 3.1 0.8 6.4 1.2 9.8 1.2 17 0 30 -11 30 -25.5 S49 2 32 2 Z\"\n                fill=\"#fff\"\n              />\n            </svg>\n          </div>\n          <div class=\"hf-bpi-title\">New render</div>\n          <div class=\"hf-bpi-subtitle\">Published to the catalog.</div>\n          <div class=\"hf-bpi-meta\">NOW</div>\n        </div>\n      </section>\n    </div>\n\n    <script>\n      window.__timelines = window.__timelines || {};\n      var tl = gsap.timeline({ paused: true });\n\n      var PITCH = 214;\n      var ENTRY = [0.5, 2.0, 3.5];\n      var banners = [\"#hf-bpi-demo-1\", \"#hf-bpi-demo-2\", \"#hf-bpi-demo-3\"];\n\n      tl.set(banners, { autoAlpha: 0 }, 0.001);\n\n      banners.forEach(function (sel, i) {\n        tl.fromTo(\n          sel,\n          { autoAlpha: 0 },\n          { autoAlpha: 1, duration: 0.3333, ease: \"none\" },\n          ENTRY[i],\n        );\n        tl.fromTo(sel, { y: 22 }, { y: 0, duration: 0.9, ease: \"expo.out\" }, ENTRY[i]);\n      });\n\n      /* restacks: everything already on screen slides up one pitch in lockstep */\n      tl.to(\"#hf-bpi-demo-1\", { y: -PITCH, duration: 1.0, ease: \"expo.out\" }, ENTRY[1]);\n      tl.to(\"#hf-bpi-demo-1\", { y: -2 * PITCH, duration: 1.0, ease: \"expo.out\" }, ENTRY[2]);\n      tl.to(\"#hf-bpi-demo-2\", { y: -PITCH, duration: 1.0, ease: \"expo.out\" }, ENTRY[2]);\n\n      window.__timelines[\"banner-push-in-demo\"] = tl;\n    </script>\n  </body>\n</html>\n"}