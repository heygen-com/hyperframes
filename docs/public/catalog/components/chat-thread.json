{"html":"<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=1920, height=1080\" />\n    <title>Chat Thread</title>\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n    <style>\n      html,\n      body {\n        margin: 0;\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n      }\n      body {\n        background: #101413;\n        font-family:\n          ui-sans-serif,\n          -apple-system,\n          \"Segoe UI\",\n          sans-serif;\n      }\n      .hf-ui-demo-canvas {\n        position: relative;\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n        background:\n          radial-gradient(\n            ellipse 70% 90% at 26% 30%,\n            rgba(60, 230, 172, 0.07) 0%,\n            rgba(60, 230, 172, 0) 60%\n          ),\n          linear-gradient(160deg, #1a201d 0%, #121614 55%, #0e1210 100%);\n      }\n      .spec-phone {\n        position: absolute;\n        left: 430px;\n        top: 158px;\n        width: 438px;\n        height: 764px;\n        border-radius: 64px;\n        background: #3a3d42;\n        box-shadow:\n          inset 0 2px 3px rgba(255, 255, 255, 0.22),\n          0 34px 80px rgba(0, 0, 0, 0.55);\n      }\n      .spec-screen {\n        position: absolute;\n        left: 14px;\n        top: 14px;\n        width: 410px;\n        height: 736px;\n        border-radius: 52px;\n        overflow: hidden;\n        background: #000;\n        container-type: size;\n      }\n      .spec-paper {\n        position: absolute;\n        left: 330px;\n        top: 90px;\n        width: 640px;\n        height: 900px;\n        container-type: size;\n        background: #ece1d5;\n        background-image: radial-gradient(\n          circle,\n          rgba(178, 150, 138, 0.18) 1.4px,\n          transparent 1.8px\n        );\n        background-size: 26px 26px;\n        border-radius: 10px;\n        box-shadow: 0 34px 80px rgba(0, 0, 0, 0.5);\n      }\n      .spec-cap {\n        position: absolute;\n        left: 1010px;\n        top: 300px;\n        width: 730px;\n      }\n      .spec-cap .name {\n        font:\n          600 46px/1.1 ui-monospace,\n          \"SF Mono\",\n          Menlo,\n          monospace;\n        color: #3ce6ac;\n        letter-spacing: -0.5px;\n      }\n      .spec-cap .rule {\n        width: 84px;\n        height: 3px;\n        background: #3ce6ac;\n        margin: 26px 0;\n      }\n      .spec-cap .desc {\n        font:\n          400 21px/1.6 ui-sans-serif,\n          -apple-system,\n          sans-serif;\n        color: #b9c2bd;\n        max-width: 620px;\n      }\n      .spec-cap .stats {\n        margin-top: 30px;\n        display: grid;\n        gap: 12px;\n      }\n      .spec-cap .stat {\n        font:\n          500 16px/1.5 ui-monospace,\n          \"SF Mono\",\n          Menlo,\n          monospace;\n        color: #78827d;\n      }\n      .spec-cap .stat b {\n        color: #e8ece9;\n        font-weight: 600;\n      }\n      *,\n      *::before,\n      *::after {\n        box-sizing: border-box;\n      }\n      #root {\n        position: absolute;\n        inset: 0;\n        overflow: hidden;\n        container-type: size;\n        isolation: isolate;\n        background: #000;\n        font-family: var(--font-body, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif);\n        pointer-events: none;\n      }\n      .cht-header {\n        position: absolute;\n        left: 0;\n        top: 3cqh;\n        width: 100cqw;\n        text-align: center;\n      }\n      .cht-avatar {\n        display: inline-grid;\n        place-items: center;\n        width: 9cqmin;\n        height: 9cqmin;\n        border-radius: 50%;\n        background: #9ce474;\n        color: #12300c;\n        font-size: 4.4cqmin;\n        font-weight: 600;\n      }\n      .cht-name {\n        display: block;\n        margin-top: 0.8cqh;\n        font-size: 2.9cqmin;\n        color: #8e8e93;\n      }\n      .cht-view {\n        position: absolute;\n        left: 0;\n        top: 14cqh;\n        width: 100cqw;\n        bottom: 12cqh;\n        overflow: hidden;\n      }\n      .cht-item {\n        position: absolute;\n        left: 4cqw;\n        width: 92cqw;\n        visibility: hidden;\n      }\n      .cht-item.sent {\n        text-align: right;\n      }\n      .cht-pop {\n        display: inline-block;\n        transform-origin: left bottom;\n      }\n      .cht-item.sent .cht-pop {\n        transform-origin: right bottom;\n      }\n      .cht-bubble {\n        display: inline-block;\n        max-width: 74cqw;\n        padding: 1.4cqh 3.6cqw;\n        border-radius: 5cqmin;\n        font-size: 3.4cqmin;\n        line-height: 1.35;\n        color: #fff;\n        text-align: left;\n      }\n      .cht-bubble.recv {\n        background: #242428;\n      }\n      .cht-bubble.sent {\n        background: #0a80f8;\n      }\n      .cht-media {\n        display: inline-block;\n        width: 52cqw;\n        aspect-ratio: 4 / 3;\n        border-radius: 4cqmin;\n        background: linear-gradient(165deg, #0f3a2c 0%, #0a9c6b 78%, #3ce6ac 100%);\n        position: relative;\n      }\n      .cht-media .cht-play {\n        position: absolute;\n        left: 50%;\n        top: 50%;\n        transform: translate(-50%, -50%);\n        width: 11cqmin;\n        height: 11cqmin;\n        border-radius: 50%;\n        background: rgba(253, 253, 253, 0.94);\n      }\n      .cht-media .cht-play::before {\n        content: \"\";\n        position: absolute;\n        left: 38%;\n        top: 30%;\n        border-left: 3.6cqmin solid #0d0d0d;\n        border-top: 2.2cqmin solid transparent;\n        border-bottom: 2.2cqmin solid transparent;\n      }\n      .cht-dots {\n        display: inline-flex;\n        align-items: center;\n        justify-content: center;\n        gap: 1cqmin;\n        width: 12cqmin;\n        height: 6.5cqmin;\n        background: #242428;\n        border-radius: 3.4cqmin;\n      }\n      .cht-dots span {\n        width: 1.7cqmin;\n        height: 1.7cqmin;\n        border-radius: 50%;\n        background: #8e8e93;\n      }\n      .cht-composer {\n        position: absolute;\n        left: 4cqw;\n        bottom: 3.5cqh;\n        width: 92cqw;\n        height: 5.6cqh;\n        border: 0.35cqmin solid #202022;\n        border-radius: 100cqmin;\n      }\n      .cht-ph {\n        position: absolute;\n        left: 9cqw;\n        bottom: 4.7cqh;\n        color: #8e8e93;\n        font-size: 3.2cqmin;\n      }\n    </style>\n  </head>\n  <body>\n    <div\n      class=\"hf-ui-demo-canvas\"\n      data-composition-id=\"chat-thread-demo\"\n      data-start=\"0\"\n      data-width=\"1920\"\n      data-height=\"1080\"\n      data-duration=\"12\"\n    >\n      <section\n        class=\"clip\"\n        data-start=\"0\"\n        data-duration=\"12\"\n        data-track-index=\"1\"\n        style=\"position: absolute; inset: 0\"\n      >\n        <div class=\"spec-phone\">\n          <div class=\"spec-screen\">\n            <div id=\"root\" style=\"position: relative; width: 100%; height: 100%; overflow: hidden\">\n              <div class=\"cht-header\">\n                <span class=\"cht-avatar\" id=\"cht-avatar\">R</span\n                ><span class=\"cht-name\" id=\"cht-name\">Rachel</span>\n              </div>\n              <div class=\"cht-view\" id=\"cht-view\"></div>\n              <div class=\"cht-composer\"></div>\n              <div class=\"cht-ph\">iMessage</div>\n            </div>\n          </div>\n        </div>\n        <div class=\"spec-cap\">\n          <div class=\"name\">chat-thread</div>\n          <div class=\"rule\"></div>\n          <div class=\"desc\">\n            A conversation as one scene: bubbles pop in on the measured entry, the thread shifts up\n            in expo lockstep, dots hold the beat before replies.\n          </div>\n          <div class=\"stats\">\n            <div class=\"stat\"><b>measured</b> — pop-in scale .75 / 0.12s</div>\n            <div class=\"stat\"><b>dynamic</b> — heights measured, choreography generated</div>\n            <div class=\"stat\"><b>any thread</b> — messages are one variable</div>\n          </div>\n        </div>\n      </section>\n    </div>\n    <script>\n      (function () {\n        \"use strict\";\n        var compositionId = \"chat-thread-demo\";\n        var root = document.getElementById(\"root\");\n        var vars =\n          window.__hyperframes && window.__hyperframes.getVariables\n            ? window.__hyperframes.getVariables()\n            : {};\n        function text(v, fb, mx) {\n          if (typeof v !== \"string\") return fb;\n          var t = v.trim();\n          if (!t) return fb;\n          return t.length > mx ? t.slice(0, mx) : t;\n        }\n        function clampNumber(v, min, max, fb) {\n          var n = typeof v === \"number\" ? v : parseFloat(v);\n          if (!isFinite(n)) return fb;\n          return Math.min(max, Math.max(min, n));\n        }\n        var contact = text(vars.contact, \"Rachel\", 16);\n        document.getElementById(\"cht-avatar\").textContent = contact.charAt(0).toUpperCase();\n        document.getElementById(\"cht-name\").textContent = contact;\n        var beat = clampNumber(vars.beat, 0.8, 3, 1.7);\n        var dotsOn = vars.dots !== \"off\";\n\n        var raw = text(\n          vars.messages,\n          \"recv:what r u using for the launch video??|sent:wait look \\ud83d\\udc40|img|recv:OMG IT'S HTML|recv:\\ud83e\\udd2f\\ud83e\\udd2f\\ud83e\\udd2f|sent:renders in 4K. no editor\",\n          600,\n        );\n        var entries = raw\n          .split(\"|\")\n          .map(function (token) {\n            return token.trim();\n          })\n          .filter(Boolean)\n          .slice(0, 10);\n        if (entries.length === 0) entries = [\"recv:hey\"];\n\n        var view = document.getElementById(\"cht-view\");\n        var items = entries.map(function (entry) {\n          var kind = \"recv\",\n            body = entry;\n          if (entry.indexOf(\"recv:\") === 0) {\n            kind = \"recv\";\n            body = entry.slice(5);\n          } else if (entry.indexOf(\"sent:\") === 0) {\n            kind = \"sent\";\n            body = entry.slice(5);\n          } else if (entry === \"img\") {\n            kind = \"img\";\n            body = \"\";\n          }\n          var item = document.createElement(\"div\");\n          item.className = \"cht-item \" + (kind === \"sent\" ? \"sent\" : \"recv\");\n          item.setAttribute(\"data-layout-allow-overflow\", \"\");\n          item.setAttribute(\"data-layout-allow-overlap\", \"\");\n          item.setAttribute(\"data-layout-allow-occlusion\", \"\");\n          var pop = document.createElement(\"div\");\n          pop.className = \"cht-pop\";\n          if (kind === \"img\") {\n            pop.innerHTML = '<span class=\"cht-media\"><span class=\"cht-play\"></span></span>';\n          } else {\n            var bubble = document.createElement(\"div\");\n            bubble.className = \"cht-bubble \" + kind;\n            bubble.textContent = body.trim();\n            pop.appendChild(bubble);\n          }\n          item.appendChild(pop);\n          view.appendChild(item);\n          return { el: item, pop: pop, kind: kind };\n        });\n        var dotsItem = null;\n        if (dotsOn) {\n          dotsItem = document.createElement(\"div\");\n          dotsItem.className = \"cht-item recv\";\n          dotsItem.setAttribute(\"data-layout-allow-overflow\", \"\");\n          dotsItem.setAttribute(\"data-layout-allow-overlap\", \"\");\n          dotsItem.setAttribute(\"data-layout-allow-occlusion\", \"\");\n          dotsItem.innerHTML =\n            '<div class=\"cht-pop\"><span class=\"cht-dots\"><span></span><span></span><span></span></span></div>';\n          view.appendChild(dotsItem);\n        }\n\n        var tl = gsap.timeline({ paused: true });\n        function build() {\n          tl.clear();\n          var viewH = view.offsetHeight || 1;\n          var gap = viewH * 0.018;\n          var heights = items.map(function (item) {\n            return item.el.offsetHeight;\n          });\n          var dotsH = dotsItem ? dotsItem.offsetHeight : 0;\n          /* arrival schedule: dots hold the front 55% of the beat before a recv */\n          var starts = [];\n          var t = 0.4;\n          items.forEach(function (item, i) {\n            if (i > 0) t += beat;\n            starts.push(t);\n          });\n          var duration = 12;\n          /* compress if the thread outruns the composition */\n          var last = starts[starts.length - 1];\n          if (last > duration - 1.2) {\n            var k = (duration - 1.6) / last;\n            starts = starts.map(function (s) {\n              return 0.4 + (s - 0.4) * k;\n            });\n          }\n          items.forEach(function (item) {\n            gsap.set(item.el, { autoAlpha: 0, y: 0 });\n          });\n          if (dotsItem) gsap.set(dotsItem, { autoAlpha: 0 });\n          /* at step k every visible item sits stacked up from the bottom */\n          items.forEach(function (item, k) {\n            var at = starts[k];\n            var bottom = viewH;\n            var yK = [];\n            for (var j = k; j >= 0; j -= 1) {\n              bottom -= heights[j];\n              yK[j] = bottom;\n              bottom -= gap;\n            }\n            for (var i = 0; i <= k; i += 1) {\n              if (i === k) {\n                tl.set(item.el, { y: yK[i] }, at);\n                tl.set(item.el, { autoAlpha: 1 }, at);\n                tl.fromTo(\n                  item.pop,\n                  { scale: 0.75, autoAlpha: 0.6 },\n                  { scale: 1, autoAlpha: 1, duration: 0.12, ease: \"power2.out\" },\n                  at,\n                );\n              } else {\n                tl.to(items[i].el, { y: yK[i], duration: 1.0, ease: \"expo.out\" }, at);\n              }\n            }\n            /* dots hold the beat before a received message */\n            if (dotsItem && item.kind === \"recv\" && k > 0) {\n              var dAt = Math.max(starts[k - 1] + 0.35, at - beat * 0.55);\n              tl.set(dotsItem, { y: viewH - dotsH }, dAt);\n              tl.set(dotsItem, { autoAlpha: 1 }, dAt);\n              tl.set(dotsItem, { autoAlpha: 0 }, at);\n            }\n          });\n          tl.set({}, {}, duration);\n          tl.seek(0);\n        }\n        build();\n        if (document.fonts && document.fonts.ready) {\n          document.fonts.ready.then(function () {\n            build();\n            tl.pause(0);\n          });\n        }\n        window.__timelines = window.__timelines || {};\n        window.__timelines[compositionId] = tl;\n      })();\n    </script>\n  </body>\n</html>\n"}