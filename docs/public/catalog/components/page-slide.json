{"html":"<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=1920, height=1080\" />\n    <title>Page Slide - Demo</title>\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n    <style>\n      * {\n        box-sizing: border-box;\n      }\n      html,\n      body {\n        margin: 0;\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n      }\n      #demo {\n        width: 1920px;\n        height: 1080px;\n        display: grid;\n        place-items: center;\n        background: #f5f5f4;\n        font-family: Inter, system-ui, sans-serif;\n      }\n      .demo-frame {\n        display: grid;\n        place-items: center;\n        min-width: 760px;\n        min-height: 480px;\n        padding: 56px;\n        /* ponytail: scale wrapper (not the GSAP target) to fill ~63% of frame */\n        transform: scale(2.2);\n        transform-origin: center center;\n      }\n      .hf-transition-page-slide {\n        position: relative;\n        width: 560px;\n        height: 320px;\n        overflow: hidden;\n        border-radius: 30px;\n        background: #111827;\n        box-shadow: 0 28px 90px rgba(0, 0, 0, 0.22);\n        font-family: Inter, system-ui, sans-serif;\n      }\n      .hf-transition-page {\n        position: absolute;\n        inset: 0;\n        display: grid;\n        place-items: center;\n      }\n      .hf-transition-page span {\n        padding: 14px 20px;\n        border-radius: 999px;\n        background: rgba(255, 255, 255, 0.14);\n        color: #ffffff;\n        font-size: 28px;\n        font-weight: 900;\n      }\n      .hf-transition-page.old {\n        background: linear-gradient(135deg, #0f172a, #334155);\n      }\n      .hf-transition-page.new {\n        background: linear-gradient(135deg, #155e75, #10b981);\n      }\n    </style>\n  </head>\n  <body>\n    <div\n      id=\"demo\"\n      data-composition-id=\"page-slide-demo\"\n      data-start=\"0\"\n      data-width=\"1920\"\n      data-height=\"1080\"\n      data-duration=\"5\"\n    >\n      <div class=\"demo-frame\">\n        <div class=\"hf-transition-page-slide\">\n          <section class=\"hf-transition-page old\"><span>Dashboard</span></section>\n          <section class=\"hf-transition-page new\"><span>Analytics</span></section>\n        </div>\n      </div>\n      <script>\n        const tl = gsap.timeline({ paused: true });\n        tl.fromTo(\n          \".hf-transition-page-slide\",\n          { opacity: 0, y: 24 },\n          { opacity: 1, y: 0, duration: 0.3, ease: \"power2.out\" },\n          0.25,\n        );\n        tl.fromTo(\n          \".hf-transition-page.new\",\n          { xPercent: 100 },\n          { xPercent: 0, duration: 0.74, ease: \"power3.inOut\" },\n          0.78,\n        );\n        tl.to(\n          \".hf-transition-page.old\",\n          { xPercent: -28, scale: 0.94, duration: 0.74, ease: \"power3.inOut\" },\n          0.78,\n        );\n        tl.fromTo(\n          \".hf-transition-page.new span\",\n          { y: 24, opacity: 0 },\n          { y: 0, opacity: 1, duration: 0.28, ease: \"power2.out\" },\n          1.24,\n        );\n        tl.set({}, {}, 5);\n        window.__timelines = window.__timelines || {};\n        window.__timelines[\"page-slide-demo\"] = tl;\n      </script>\n    </div>\n  </body>\n</html>\n"}