{"html":"<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=1920, height=1080\" />\n    <title>Page Slide - Demo</title>\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n    <style>\n      * {\n        box-sizing: border-box;\n      }\n      html,\n      body {\n        margin: 0;\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n      }\n      #demo {\n        width: 1920px;\n        height: 1080px;\n        display: grid;\n        place-items: center;\n        background: #f5f5f4;\n        font-family: Inter, system-ui, sans-serif;\n      }\n      .demo-frame {\n        display: grid;\n        place-items: center;\n        min-width: 760px;\n        min-height: 480px;\n        padding: 56px;\n        /* ponytail: scale wrapper (not the GSAP target) to fill ~63% of frame */\n        transform: scale(2.2);\n        transform-origin: center center;\n      }\n      .hf-transition-page-slide {\n        position: relative;\n        width: 560px;\n        height: 320px;\n        overflow: hidden;\n        border-radius: 30px;\n        background: #111827;\n        box-shadow: 0 28px 90px rgba(0, 0, 0, 0.22);\n        font-family: Inter, system-ui, sans-serif;\n      }\n      .hf-transition-page {\n        position: absolute;\n        inset: 0;\n        display: grid;\n        place-items: center;\n      }\n      .hf-transition-page span {\n        padding: 14px 20px;\n        border-radius: 999px;\n        background: rgba(255, 255, 255, 0.14);\n        color: #ffffff;\n        font-size: 28px;\n        font-weight: 900;\n      }\n      .hf-transition-page.old {\n        background: linear-gradient(135deg, #0f172a, #334155);\n      }\n      .hf-transition-page.new {\n        background: linear-gradient(135deg, #155e75, #10b981);\n      }\n    </style>\n  </head>\n  <body>\n    <div\n      id=\"demo\"\n      data-composition-id=\"page-slide-demo\"\n      data-start=\"0\"\n      data-width=\"1920\"\n      data-height=\"1080\"\n      data-duration=\"5\"\n    >\n      <div class=\"demo-frame\">\n        <div class=\"hf-transition-page-slide\" data-composition-variables='[\n    { \"id\": \"label_a\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Outgoing label\", \"description\": \"Label printed on the page that slides out.\", \"default\": \"Dashboard\" },\n    { \"id\": \"label_b\", \"type\": \"string\", \"role\": \"content\", \"label\": \"Incoming label\", \"description\": \"Label printed on the page that slides in.\", \"default\": \"Analytics\" },\n    { \"id\": \"accent\", \"type\": \"enum\", \"role\": \"style\", \"label\": \"Accent\", \"description\": \"Gradient family painted on the incoming page. The outgoing page stays slate.\", \"default\": \"green\", \"options\": [{ \"value\": \"green\", \"label\": \"Green\" }, { \"value\": \"blue\", \"label\": \"Blue\" }, { \"value\": \"violet\", \"label\": \"Violet\" }] },\n    { \"id\": \"corner\", \"type\": \"enum\", \"role\": \"style\", \"label\": \"Corner\", \"description\": \"Corner radius of the frame the pages slide inside.\", \"default\": \"round\", \"options\": [{ \"value\": \"square\", \"label\": \"Square\" }, { \"value\": \"soft\", \"label\": \"Soft\" }, { \"value\": \"round\", \"label\": \"Round\" }] }\n  ]'>\n          <section class=\"hf-transition-page old\"><span>Dashboard</span></section>\n          <section class=\"hf-transition-page new\"><span>Analytics</span></section>\n        </div>\n      </div>\n      <script>\n  (function () {\n    \"use strict\";\n\n    var vars =\n      window.__hyperframes && window.__hyperframes.getVariables\n        ? window.__hyperframes.getVariables()\n        : {};\n\n    // Unrecognised overrides return to their declared defaults.\n    var accents = {\n      green: { from: \"#155e75\", to: \"#10b981\" },\n      blue: { from: \"#1e3a8a\", to: \"#38bdf8\" },\n      violet: { from: \"#4c1d95\", to: \"#a78bfa\" },\n    };\n    var corners = { square: \"0px\", soft: \"14px\", round: \"30px\" };\n\n    function text(value, fallback) {\n      return typeof value === \"string\" && value !== \"\" ? value : fallback;\n    }\n    function pick(table, value, fallback) {\n      return Object.prototype.hasOwnProperty.call(table, value) ? value : fallback;\n    }\n\n    var labelA = text(vars.label_a, \"Dashboard\");\n    var labelB = text(vars.label_b, \"Analytics\");\n    var accent = accents[pick(accents, vars.accent, \"green\")];\n    var corner = corners[pick(corners, vars.corner, \"round\")];\n\n    var roots = document.querySelectorAll(\".hf-transition-page-slide\");\n    for (var i = 0; i < roots.length; i += 1) {\n      var root = roots[i];\n      root.style.setProperty(\"--hf-page-radius\", corner);\n      root.style.setProperty(\"--hf-page-from\", accent.from);\n      root.style.setProperty(\"--hf-page-to\", accent.to);\n      var oldLabel = root.querySelector(\".hf-transition-page.old span\");\n      var newLabel = root.querySelector(\".hf-transition-page.new span\");\n      if (oldLabel) oldLabel.textContent = labelA;\n      if (newLabel) newLabel.textContent = labelB;\n    }\n  })();\n</script>\n<script>\n        const tl = gsap.timeline({ paused: true });\n        tl.fromTo(\n          \".hf-transition-page-slide\",\n          { opacity: 0, y: 24 },\n          { opacity: 1, y: 0, duration: 0.3, ease: \"power2.out\" },\n          0.25,\n        );\n        tl.fromTo(\n          \".hf-transition-page.new\",\n          { xPercent: 100 },\n          { xPercent: 0, duration: 0.74, ease: \"power3.inOut\" },\n          0.78,\n        );\n        tl.to(\n          \".hf-transition-page.old\",\n          { xPercent: -28, scale: 0.94, duration: 0.74, ease: \"power3.inOut\" },\n          0.78,\n        );\n        tl.fromTo(\n          \".hf-transition-page.new span\",\n          { y: 24, opacity: 0 },\n          { y: 0, opacity: 1, duration: 0.28, ease: \"power2.out\" },\n          1.24,\n        );\n        tl.set({}, {}, 5);\n        window.__timelines = window.__timelines || {};\n        window.__timelines[\"page-slide-demo\"] = tl;\n      </script>\n    </div>\n  <style>\n  .hf-transition-page-slide {\n    position: relative;\n    width: 560px;\n    height: 320px;\n    overflow: hidden;\n    border-radius: var(--hf-page-radius, 30px);\n    background: #111827;\n    box-shadow: 0 28px 90px rgba(0, 0, 0, 0.22);\n    font-family: Inter, system-ui, sans-serif;\n  }\n  .hf-transition-page {\n    position: absolute;\n    inset: 0;\n    display: grid;\n    place-items: center;\n  }\n  .hf-transition-page span {\n    padding: 14px 20px;\n    border-radius: 999px;\n    background: rgba(255, 255, 255, 0.14);\n    color: #ffffff;\n    font-size: 28px;\n    font-weight: 900;\n  }\n  .hf-transition-page.old {\n    background: linear-gradient(135deg, #0f172a, #334155);\n  }\n  .hf-transition-page.new {\n    background: linear-gradient(135deg, var(--hf-page-from, #155e75), var(--hf-page-to, #10b981));\n  }\n</style>\n</body>\n</html>\n"}