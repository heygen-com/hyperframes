{"html":"<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=1920, height=1080\" />\n    <title>Line Reveal List</title>\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n    <style>\n      html,\n      body {\n        margin: 0;\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n      }\n      body {\n        background: #ece1d5;\n      }\n      .hf-ui-demo-canvas {\n        position: relative;\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n        background: #ece1d5;\n        background-image: radial-gradient(circle, rgba(178, 150, 138, 0.18) 2px, transparent 2.6px);\n        background-size: 36px 36px;\n        font-family:\n          ui-sans-serif,\n          -apple-system,\n          BlinkMacSystemFont,\n          \"Segoe UI\",\n          sans-serif;\n      }\n      .hf-lrl-list {\n        position: absolute;\n        left: 560px;\n        top: 300px;\n        display: grid;\n        gap: 30px;\n        font-size: 56px;\n        color: #191919;\n        line-height: 1.25;\n      }\n      .hf-lrl-line {\n        opacity: 0;\n      }\n      .hf-lrl-mark {\n        display: inline-block;\n        width: 1.1em;\n        color: #0a6e5c;\n      }\n    </style>\n  </head>\n  <body>\n    <div\n      id=\"hf-lrl-demo-root\"\n      class=\"hf-ui-demo-canvas\"\n      data-composition-id=\"line-reveal-list-demo\"\n      data-start=\"0\"\n      data-width=\"1920\"\n      data-height=\"1080\"\n      data-duration=\"9\"\n    >\n      <section class=\"clip\" data-start=\"0\" data-duration=\"9\" data-track-index=\"1\" style=\"position: absolute; inset: 0\">\n        <div class=\"hf-lrl-list\" id=\"hf-lrl-demo-list\">\n          <div class=\"hf-lrl-line\"><span class=\"hf-lrl-mark\">&#10003;</span>write the scene in plain HTML</div>\n          <div class=\"hf-lrl-line\"><span class=\"hf-lrl-mark\">&#10003;</span>hyperframes check catches the misses</div>\n          <div class=\"hf-lrl-line\"><span class=\"hf-lrl-mark\">&#10003;</span>render lands the same, every time</div>\n          <div class=\"hf-lrl-line\"><span class=\"hf-lrl-mark\">&#10003;</span>ship it</div>\n        </div>\n      </section>\n    </div>\n\n    <script>\n      window.__timelines = window.__timelines || {};\n      var tl = gsap.timeline({ paused: true });\n\n      /* the measured writing cadence, compressed 2x for the demo */\n      var CADENCE = [1.1, 1.015, 1.485, 1.55];\n      var t = 0.5;\n      gsap.utils.toArray(\"#hf-lrl-demo-list .hf-lrl-line\").forEach(function (line, i) {\n        if (i > 0) t += CADENCE[(i - 1) % CADENCE.length];\n        tl.fromTo(line, { autoAlpha: 0, y: 14 }, { autoAlpha: 1, y: 0, duration: 0.23, ease: \"power2.out\" }, t);\n      });\n\n      /* one measured scroll-settle after the third line */\n      var EASE = [0.0, 0.062, 0.297, 0.498, 0.684, 0.786, 0.889, 0.934, 0.968, 0.992, 1.0];\n      EASE.forEach(function (p, k) {\n        tl.set(\"#hf-lrl-demo-list\", { y: -100 * p }, 3.9 + k * 0.055);\n      });\n      tl.set({}, {}, 9);\n\n      window.__timelines[\"line-reveal-list-demo\"] = tl;\n    </script>\n  </body>\n</html>\n"}