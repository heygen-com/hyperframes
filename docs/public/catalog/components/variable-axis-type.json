{"html":"<!doctype html>\n<!--\n  variable-axis-type -- mount-contract demo. The width-axis override makes\n  glyph advances change across the requested 0.1s, 0.5s, and 0.9s snapshots,\n  while the primitive's fixed nowrap box proves the authored line stays stable.\n-->\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=1920, height=1080\" />\n    <title>Variable Axis Type - Demo</title>\n    <style>\n      * {\n        margin: 0;\n        padding: 0;\n        box-sizing: border-box;\n      }\n\n      html,\n      body {\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n        background: #05070d;\n      }\n\n      #root {\n        --bg: #0b1120;\n        --fg: #f8fafc;\n        --surface: #111a2c;\n        --border: rgba(148, 163, 184, 0.28);\n        --font-display: \"Roboto Flex\", sans-serif;\n        position: relative;\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n        background: radial-gradient(ellipse at 50% 45%, #18243d 0%, #05070d 72%);\n      }\n\n      .mount-card {\n        width: 70%;\n        height: 44%;\n        left: 15%;\n        top: 28%;\n        overflow: hidden;\n        border: 1px solid var(--border);\n        border-radius: 32px;\n        box-shadow: 0 44px 100px rgba(0, 0, 0, 0.45);\n      }\n    </style>\n  </head>\n  <body>\n    <div\n      id=\"root\"\n      data-composition-id=\"variable-axis-type-demo\"\n      data-start=\"0\"\n      data-width=\"1920\"\n      data-height=\"1080\"\n      data-duration=\"1.6\"\n      data-fps=\"30\"\n    >\n      <div\n        id=\"variable-axis-type-mount\"\n        class=\"mount-card clip\"\n        data-composition-id=\"variable-axis-type\"\n        data-composition-src=\"data:text/html;base64,\"\n       \n        data-start=\"0\"\n        data-duration=\"1.6\"\n        data-track-index=\"0\"\n        data-width=\"1344\"\n        data-height=\"475\"\n      ></div>\n    </div>\n\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n    <script>\n      window.__timelines = window.__timelines || {};\n      window.__timelines[\"variable-axis-type-demo\"] = gsap.timeline({ paused: true });\n    </script>\n  </body>\n</html>\n"}