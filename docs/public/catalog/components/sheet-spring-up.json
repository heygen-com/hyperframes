{"html":"<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=1920, height=1080\" />\n    <title>Sheet Spring-Up</title>\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n    <style>\n      html,\n      body {\n        margin: 0;\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n      }\n      body {\n        background: #0a0a0a;\n      }\n      .hf-ui-demo-canvas {\n        position: relative;\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n        background: linear-gradient(160deg, #0f3057 0%, #00587a 100%);\n        font-family:\n          ui-sans-serif,\n          -apple-system,\n          BlinkMacSystemFont,\n          \"Segoe UI\",\n          sans-serif;\n      }\n      .hf-ssu-sheet {\n        position: absolute;\n        left: 626px;\n        top: 330px;\n        width: 668px;\n        border-radius: 34px;\n        background: #f9f9f9;\n        color: #101010;\n        box-shadow: 0 18px 42px rgba(0, 0, 0, 0.28);\n        padding: 49px 43px 43px;\n      }\n      .hf-ssu-title {\n        text-align: center;\n        font-size: 44px;\n        font-weight: 600;\n        line-height: 1;\n        letter-spacing: 0.2px;\n      }\n      .hf-ssu-body {\n        margin-top: 24px;\n        text-align: center;\n        font-size: 29px;\n        color: #313131;\n      }\n      .hf-ssu-actions {\n        margin-top: 40px;\n        display: flex;\n        justify-content: center;\n        gap: 60px;\n        font-size: 34px;\n      }\n      .hf-ssu-actions .decline {\n        color: #6f6f73;\n      }\n      .hf-ssu-actions .accept {\n        color: #087a57;\n        font-weight: 600;\n      }\n    </style>\n  </head>\n  <body>\n    <div\n      id=\"hf-ssu-demo-root\"\n      class=\"hf-ui-demo-canvas\"\n      data-composition-id=\"sheet-spring-up-demo\"\n      data-start=\"0\"\n      data-width=\"1920\"\n      data-height=\"1080\"\n      data-duration=\"3\"\n    >\n      <section\n        class=\"clip\"\n        data-start=\"0\"\n        data-duration=\"3\"\n        data-track-index=\"1\"\n        style=\"position: absolute; inset: 0\"\n      >\n        <div class=\"hf-ssu-sheet\" id=\"hf-ssu-demo-sheet\">\n          <div class=\"hf-ssu-title\">Share</div>\n          <div class=\"hf-ssu-body\"><b>HyperFrames</b> would like to share a video</div>\n          <div class=\"hf-ssu-actions\">\n            <span class=\"decline\">Decline</span>\n            <span class=\"accept\">Accept</span>\n          </div>\n        </div>\n      </section>\n    </div>\n\n    <script>\n      window.__timelines = window.__timelines || {};\n      var tl = gsap.timeline({ paused: true });\n\n      /* the measured spring, verbatim */\n      var SPRING = [\n        [0.0, 1450, 0.0],\n        [0.057, 1198, 0.13],\n        [0.09, 903, 0.21],\n        [0.123, 648, 0.36],\n        [0.157, 437, 0.43],\n        [0.19, 262, 0.5],\n        [0.223, 120, 0.62],\n        [0.257, 8, 0.78],\n        [0.29, -76, 0.89],\n        [0.323, -138, 1.0],\n        [0.357, -175, null],\n        [0.39, -191, null],\n        [0.423, -192, null],\n        [0.457, -181, null],\n        [0.49, -159, null],\n        [0.523, -131, null],\n        [0.557, -100, null],\n        [0.59, -68, null],\n        [0.623, -41, null],\n        [0.657, -18, null],\n        [0.69, -5, null],\n        [0.723, 0, null],\n      ];\n      var START = 0.4;\n      SPRING.forEach(function (s) {\n        var props = { y: s[1] };\n        if (s[2] !== null) props.autoAlpha = s[2];\n        tl.set(\"#hf-ssu-demo-sheet\", props, START + s[0]);\n      });\n      tl.set({}, {}, 3);\n\n      window.__timelines[\"sheet-spring-up-demo\"] = tl;\n    </script>\n  </body>\n</html>\n"}