{"html":"<!doctype html>\n<!--\n  trust-strip demo. Generous wide mount (90% x 50%, centered vertically) on a\n  light editorial backdrop: the five logo marks spread across the frame with\n  real presence instead of being pinched into a narrow band.\n-->\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=1920, height=1080\" />\n    <title>trust-strip Demo</title>\n    <style>\n      * {\n        margin: 0;\n        padding: 0;\n        box-sizing: border-box;\n      }\n\n      html,\n      body {\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n        background: var(--bg, #f4f6f9);\n      }\n\n      #root {\n        --bg: #f4f6f9;\n        --fg: #14161b;\n        --surface: #ffffff;\n        --border: #dfe4ec;\n        --brand: #1d4ed8;\n        --accent: #0284c7;\n        --font-mono: ui-monospace, \"SF Mono\", Menlo, Consolas, monospace;\n        position: relative;\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n        background: radial-gradient(ellipse at 50% 40%, #ffffff 0%, var(--bg, #f4f6f9) 70%);\n      }\n\n      .mount-stage {\n        width: 90%;\n        height: 50%;\n        left: 5%;\n        top: 25%;\n        container-type: size;\n        overflow: hidden;\n      }\n    </style>\n  </head>\n  <body>\n    <div\n      id=\"root\"\n      data-composition-id=\"trust-strip-demo\"\n      data-start=\"0\"\n      data-width=\"1920\"\n      data-height=\"1080\"\n      data-duration=\"3.5\"\n      data-fps=\"30\"\n    >\n      <div\n        id=\"trust-strip-mount\"\n        class=\"mount-stage clip\"\n        data-composition-id=\"trust-strip\"\n        data-composition-src=\"data:text/html;base64,\"\n       \n        data-start=\"0\"\n        data-duration=\"3.5\"\n        data-track-index=\"0\"\n        data-width=\"1728\"\n        data-height=\"540\"\n      ></div>\n    </div>\n\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n    <script>\n      window.__timelines = window.__timelines || {};\n      window.__timelines[\"trust-strip-demo\"] = gsap.timeline({ paused: true });\n    </script>\n  </body>\n</html>\n"}