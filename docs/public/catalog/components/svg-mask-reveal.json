{"html":"<!doctype html>\n<!--\n  svg-mask-reveal -- mounted demo. This standalone composition owns the stage\n  and theme tokens, then mounts svg-mask-reveal.html through\n  data-composition-src. A successful runtime check and snapshot therefore\n  prove the template transport, host sizing, variable flow, and hardcoded\n  timeline key together. The demo is not installed by hyperframes add.\n-->\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=1920, height=1080\" />\n    <title>SVG Mask Reveal - Demo</title>\n    <style>\n      * {\n        margin: 0;\n        padding: 0;\n        box-sizing: border-box;\n      }\n\n      html,\n      body {\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n      }\n\n      #root {\n        --bg: #07111f;\n        --fg: #f8fafc;\n        --muted: #8da2b8;\n        --surface: #101d31;\n        --border: rgba(248, 250, 252, 0.22);\n        --brand: #ff7a33;\n        --accent: #22d3ee;\n        --font-display: Inter, system-ui, sans-serif;\n        --font-body: Inter, system-ui, sans-serif;\n        --font-mono: ui-monospace, \"SFMono-Regular\", Consolas, monospace;\n        --radius: 24px;\n        --space-1: 8px;\n        --space-2: 16px;\n        --space-3: 32px;\n        --dur-beat: 0.4s;\n        --ease-standard: cubic-bezier(0.215, 0.61, 0.355, 1);\n        --ease-emphasis: cubic-bezier(0.19, 1, 0.22, 1);\n\n        position: relative;\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n        background: radial-gradient(circle at 50% 42%, var(--surface), var(--bg) 68%);\n        color: var(--fg);\n        font-family: var(--font-body);\n      }\n\n      .mount-card {\n        --bg: var(--surface);\n        position: absolute;\n        width: 70%;\n        height: 44%;\n        left: 15%;\n        top: 28%;\n        overflow: hidden;\n        border: 1px solid var(--border);\n        border-radius: var(--radius);\n        box-shadow: 0 40px 100px color-mix(in srgb, var(--bg) 72%, transparent);\n        container-type: size;\n        isolation: isolate;\n      }\n    </style>\n  </head>\n  <body>\n    <div\n      id=\"root\"\n      data-composition-id=\"svg-mask-reveal-demo\"\n      data-start=\"0\"\n      data-width=\"1920\"\n      data-height=\"1080\"\n      data-duration=\"4\"\n      data-fps=\"30\"\n    >\n      <div\n        id=\"svg-mask-reveal-mount\"\n        class=\"mount-card clip\"\n        data-composition-id=\"svg-mask-reveal\"\n        data-composition-src=\"data:text/html;base64,\"\n       \n        data-start=\"0\"\n        data-duration=\"4\"\n        data-track-index=\"0\"\n        data-width=\"1344\"\n        data-height=\"475\"\n      ></div>\n    </div>\n\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n    <script>\n      window.__timelines = window.__timelines || {};\n      window.__timelines[\"svg-mask-reveal-demo\"] = gsap.timeline({ paused: true });\n    </script>\n  </body>\n</html>\n"}