{"html":"<!doctype html>\n<!--\n  ascii-render-pass demo. A full-bleed 1920x1080 LIGHT host mounts the\n  primitive through data-composition-src with non-default variables\n  (fine grid, earlier resolve, blue accent) and supplies the scene slot\n  to prove the snapshot raster path while the primitive stays elastic.\n-->\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=1920, height=1080\" />\n    <title>ASCII Render Pass Demo</title>\n    <style>\n      * {\n        margin: 0;\n        padding: 0;\n        box-sizing: border-box;\n      }\n\n      html,\n      body {\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n        background: var(--bg, #f5f6f8);\n      }\n\n      #root {\n        --bg: #f5f6f8;\n        --fg: #101318;\n        --muted: #5b6472;\n        --surface: #ffffff;\n        --border: #d7dce4;\n        --brand: #14a35e;\n        --accent: #2f6fed;\n        --accent-2: #7a5cd6;\n        --radius: 24px;\n        --font-display: \"Inter\", system-ui, sans-serif;\n        --font-mono: ui-monospace, \"SF Mono\", Menlo, Consolas, monospace;\n        position: relative;\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n        background: var(--bg);\n      }\n\n      .mount-stage {\n        position: absolute;\n        inset: 0;\n        container-type: size;\n        overflow: hidden;\n      }\n\n      .ascii-demo-scene {\n        display: grid;\n        place-items: center;\n        gap: 20px;\n      }\n\n      .ascii-demo-scene .panel {\n        display: grid;\n        place-items: center;\n        gap: 16px;\n        width: 860px;\n        height: 460px;\n        border-radius: 32px;\n        background: #101318;\n      }\n\n      .ascii-demo-scene .word {\n        color: #ffffff;\n        font-family: system-ui, sans-serif;\n        font-size: 132px;\n        font-weight: 600;\n        letter-spacing: -0.01em;\n      }\n\n      .ascii-demo-scene .tag {\n        color: #9aa5b4;\n        font-family: ui-monospace, Menlo, monospace;\n        font-size: 30px;\n        letter-spacing: 0.16em;\n        text-transform: uppercase;\n      }\n    </style>\n  </head>\n  <body>\n    <template data-slot=\"ascii-render-pass-scene\">\n      <div class=\"ascii-demo-scene\">\n        <div class=\"panel\">\n          <span class=\"word\">SHIP IT</span>\n          <span class=\"tag\">build 4.2.0</span>\n        </div>\n      </div>\n    </template>\n\n    <div\n      id=\"root\"\n      data-composition-id=\"ascii-render-pass-demo\"\n      data-start=\"0\"\n      data-width=\"1920\"\n      data-height=\"1080\"\n      data-duration=\"4\"\n      data-fps=\"30\"\n    >\n      <div\n        id=\"ascii-render-pass-mount\"\n        class=\"mount-stage clip\"\n        data-composition-id=\"ascii-render-pass\"\n        data-composition-src=\"data:text/html;base64,\"\n       \n        data-start=\"0\"\n        data-duration=\"4\"\n        data-track-index=\"0\"\n        data-width=\"1920\"\n        data-height=\"1080\"\n      ></div>\n    </div>\n\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n    <script>\n      window.__timelines = window.__timelines || {};\n      window.__timelines[\"ascii-render-pass-demo\"] = gsap.timeline({ paused: true });\n    </script>\n  </body>\n</html>\n"}