{"html":"<!doctype html>\n<!--\n  rubber-band-bumper demo. This standalone composition mounts the primitive\n  through data-composition-src. Left and violet are non-default values that\n  prove both variables flow through the elastic host box.\n-->\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=1920, height=1080\" />\n    <title>Rubber Band Bumper Demo</title>\n    <style>\n      * {\n        margin: 0;\n        padding: 0;\n        box-sizing: border-box;\n      }\n\n      html,\n      body {\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n        background: #0b0c0e;\n      }\n\n      #root {\n        --bg: #0b0c0e;\n        --fg: #f8fafc;\n        --font-display: Inter, system-ui, sans-serif;\n        --font-body: Inter, system-ui, sans-serif;\n        --font-mono: ui-monospace, \"SF Mono\", Menlo, Consolas, monospace;\n        position: relative;\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n        background: radial-gradient(circle at 50% 45%, #1b2130 0%, #0b0c0e 66%);\n      }\n\n      .mount-card {\n        width: 76%;\n        height: 74%;\n        left: 12%;\n        top: 13%;\n        container-type: size;\n        overflow: hidden;\n        border: 1px solid rgba(148, 163, 184, 0.26);\n        border-radius: 34px;\n        background: #111827;\n        box-shadow: 0 48px 120px rgba(0, 0, 0, 0.52);\n      }\n    </style>\n  </head>\n  <body>\n    <div\n      id=\"root\"\n      data-composition-id=\"rubber-band-bumper-demo\"\n      data-start=\"0\"\n      data-width=\"1920\"\n      data-height=\"1080\"\n      data-duration=\"2.5\"\n      data-fps=\"30\"\n    >\n      <div\n        id=\"rubber-band-bumper-mount\"\n        class=\"mount-card clip\"\n        data-composition-id=\"rubber-band-bumper\"\n        data-composition-src=\"data:text/html;base64,\"\n       \n        data-start=\"0\"\n        data-duration=\"2.5\"\n        data-track-index=\"0\"\n        data-width=\"1459\"\n        data-height=\"799\"\n      ></div>\n    </div>\n\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n    <script>\n      window.__timelines = window.__timelines || {};\n      window.__timelines[\"rubber-band-bumper-demo\"] = gsap.timeline({ paused: true });\n    </script>\n  </body>\n</html>\n"}