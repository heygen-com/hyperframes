{"html":"<!doctype html>\n<!--\n  physical-exit demo. This standalone composition mounts physical-exit.html\n  through data-composition-src. Non-default values select slide mode, replace\n  the card word, and switch the accent to prove all variables flow through the\n  mount while the primitive remains sized by its host box.\n-->\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=1920, height=1080\" />\n    <title>Physical Exit Demo</title>\n    <style>\n      * {\n        margin: 0;\n        padding: 0;\n        box-sizing: border-box;\n      }\n\n      html,\n      body {\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n        background: #0b0c0e;\n      }\n\n      #root {\n        --bg: #0b0c0e;\n        --fg: #f8fafc;\n        --surface: #17191f;\n        --border: #343842;\n        --font-display: Inter, system-ui, sans-serif;\n        --font-body: Inter, system-ui, sans-serif;\n        position: relative;\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n        background: radial-gradient(ellipse at 50% 42%, #1a1d24 0%, #0b0c0e 72%);\n      }\n\n      .mount-card {\n        width: 58%;\n        height: 58%;\n        left: 21%;\n        top: 21%;\n        container-type: size;\n        overflow: hidden;\n        border: 1px solid rgba(255, 255, 255, 0.12);\n        border-radius: 32px;\n        background: #111318;\n        box-shadow: 0 44px 110px rgba(0, 0, 0, 0.48);\n      }\n    </style>\n  </head>\n  <body>\n    <div\n      id=\"root\"\n      data-composition-id=\"physical-exit-demo\"\n      data-start=\"0\"\n      data-width=\"1920\"\n      data-height=\"1080\"\n      data-duration=\"3\"\n      data-fps=\"30\"\n    >\n      <div\n        id=\"physical-exit-mount\"\n        class=\"mount-card clip\"\n        data-composition-id=\"physical-exit\"\n        data-composition-src=\"data:text/html;base64,\"\n       \n        data-start=\"0\"\n        data-duration=\"3\"\n        data-track-index=\"0\"\n        data-width=\"1114\"\n        data-height=\"626\"\n      ></div>\n    </div>\n\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n    <script>\n      window.__timelines = window.__timelines || {};\n      window.__timelines[\"physical-exit-demo\"] = gsap.timeline({ paused: true });\n    </script>\n  </body>\n</html>\n"}