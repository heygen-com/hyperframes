{"html":"<!doctype html>\n<!-- Caret Swap demo. Defaults and 100-frame timing follow the pinned Hyfrme reference. -->\n<html lang=\"en\">\n  <head><base href=\"/public/catalog/items/caret-swap/\">\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=1280, height=720\" />\n    <title>Caret Swap Demo</title>\n    <style>\n      * {\n        box-sizing: border-box;\n        margin: 0;\n        padding: 0;\n      }\n      html,\n      body,\n      #root {\n        width: 1280px;\n        height: 720px;\n        overflow: hidden;\n      }\n      #root {\n        position: relative;\n      }\n      .cs-demo-background,\n      .cs-demo-mount {\n        position: absolute;\n        inset: 0;\n        width: 1280px;\n        height: 720px;\n      }\n      .cs-demo-background {\n        background: #fdf6f0;\n      }\n    </style>\n  </head>\n  <body>\n    <div\n      id=\"root\"\n      data-composition-id=\"caret-swap-demo\"\n      data-start=\"0\"\n      data-width=\"1280\"\n      data-height=\"720\"\n      data-duration=\"3.3333333333333335\"\n      data-fps=\"30\"\n    >\n      <div\n        id=\"cs-demo-background\"\n        class=\"cs-demo-background clip\"\n        data-start=\"0\"\n        data-duration=\"3.3333333333333335\"\n        data-track-index=\"0\"\n      ></div>\n      <div\n        id=\"cs-demo-mount\"\n        class=\"cs-demo-mount clip\"\n        data-composition-id=\"caret-swap\"\n        data-composition-src=\"data:text/html;base64,\"\n        data-start=\"0\"\n        data-duration=\"3.3333333333333335\"\n        data-track-index=\"1\"\n        data-width=\"1280\"\n        data-height=\"720\"\n      ></div>\n    </div>\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n    <script>\n      window.__timelines = window.__timelines || {};\n      window.__timelines[\"caret-swap-demo\"] = gsap.timeline({ paused: true });\n    </script>\n  </body>\n</html>\n"}