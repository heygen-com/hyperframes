{"html":"<!doctype html>\n<!--\n  pan-stations demo. This standalone 1920x1080 host mounts the primitive via\n  data-composition-src in a wide stage so the lateral camera move is legible.\n  Non-default variables prove per-instance content, layout, and timing flow.\n-->\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=1920, height=1080\" />\n    <title>Pan Stations - Demo</title>\n    <style>\n      * {\n        margin: 0;\n        padding: 0;\n        box-sizing: border-box;\n      }\n\n      html,\n      body {\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n        background: #05070d;\n      }\n\n      #root {\n        position: relative;\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n        background: radial-gradient(ellipse at 50% 45%, #14213a 0%, #05070d 72%);\n      }\n\n      .pan-stations-mount {\n        --bg: #0b1120;\n        --fg: #f8fafc;\n        --surface: #17233b;\n        --brand: #34d399;\n        --accent: #60a5fa;\n        --muted: #a5b4cc;\n        --border: #34445f;\n        width: 86%;\n        height: 72%;\n        left: 7%;\n        top: 14%;\n        overflow: hidden;\n        border: 1px solid #34445f;\n        border-radius: 32px;\n        box-shadow: 0 48px 110px rgba(0, 0, 0, 0.48);\n      }\n    </style>\n  </head>\n  <body>\n    <div\n      id=\"root\"\n      data-composition-id=\"pan-stations-demo\"\n      data-start=\"0\"\n      data-width=\"1920\"\n      data-height=\"1080\"\n      data-duration=\"4\"\n      data-fps=\"30\"\n    >\n      <div\n        id=\"pan-stations-mount\"\n        class=\"pan-stations-mount clip\"\n        data-composition-id=\"pan-stations\"\n        data-composition-src=\"data:text/html;base64,\"\n       \n        data-start=\"0\"\n        data-duration=\"4\"\n        data-track-index=\"0\"\n        data-width=\"1651\"\n        data-height=\"778\"\n      ></div>\n    </div>\n\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n    <script>\n      window.__timelines = window.__timelines || {};\n      window.__timelines[\"pan-stations-demo\"] = gsap.timeline({ paused: true });\n    </script>\n  </body>\n</html>\n"}