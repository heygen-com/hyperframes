{"html":"<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=1920, height=1080\" />\n    <title>Streaming Text</title>\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n    <style>\n      html,\n      body {\n        margin: 0;\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n      }\n      body {\n        background: #fdfdfd;\n      }\n      .hf-ui-demo-canvas {\n        position: relative;\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n        background: #fdfdfd;\n        font-family:\n          ui-sans-serif,\n          -apple-system,\n          BlinkMacSystemFont,\n          \"Segoe UI\",\n          sans-serif;\n      }\n      .hf-st-p {\n        position: absolute;\n        left: 420px;\n        top: 400px;\n        width: 1080px;\n        margin: 0;\n        font-size: 54px;\n        line-height: 1.43;\n        letter-spacing: 0.046em;\n        color: #141414;\n      }\n      .hf-st-p .w {\n        opacity: 0;\n      }\n    </style>\n  </head>\n  <body>\n    <div\n      id=\"hf-st-demo-root\"\n      class=\"hf-ui-demo-canvas\"\n      data-composition-id=\"streaming-text-demo\"\n      data-start=\"0\"\n      data-width=\"1920\"\n      data-height=\"1080\"\n      data-duration=\"5\"\n    >\n      <section\n        class=\"clip\"\n        data-start=\"0\"\n        data-duration=\"5\"\n        data-track-index=\"1\"\n        style=\"position: absolute; inset: 0\"\n      >\n        <p class=\"hf-st-p\" id=\"hf-st-demo-p\">\n          <span class=\"w\">You</span> <span class=\"w\">don't</span> <span class=\"w\">need</span>\n          <span class=\"w\">a</span> <span class=\"w\">video</span> <span class=\"w\">editor.</span>\n          <span class=\"w\">HyperFrames</span> <span class=\"w\">renders</span>\n          <span class=\"w\">the</span> <span class=\"w\">HTML</span> <span class=\"w\">you</span>\n          <span class=\"w\">already</span> <span class=\"w\">write</span> <span class=\"w\">into</span>\n          <span class=\"w\">pixel-perfect,</span> <span class=\"w\">deterministic</span>\n          <span class=\"w\">video.</span>\n        </p>\n      </section>\n    </div>\n\n    <script>\n      window.__timelines = window.__timelines || {};\n      var tl = gsap.timeline({ paused: true });\n\n      /* the measured token rhythm, cycled */\n      var GAPS = [\n        0.167, 0.1, 0.0, 0.367, 0.0, 0.167, 0.133, 0.1, 0.1, 0.133, 0.167, 0.133, 0.0, 0.233, 0.167,\n        0.1, 0.0, 0.133, 0.133, 0.1, 0.167, 0.133, 0.1, 0.133, 0.167, 0.1, 0.133, 0.1, 0.133,\n      ];\n      var t = 0.6;\n      gsap.utils.toArray(\"#hf-st-demo-p .w\").forEach(function (w, i) {\n        if (i > 0) t += GAPS[i % GAPS.length];\n        tl.set(w, { opacity: 1 }, t);\n        tl.fromTo(w, { color: \"#767676\" }, { color: \"#141414\", duration: 0.2667, ease: \"none\" }, t);\n      });\n      tl.set({}, {}, 5);\n\n      window.__timelines[\"streaming-text-demo\"] = tl;\n    </script>\n  </body>\n</html>\n"}