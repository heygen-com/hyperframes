{"html":"<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=1920, height=1080\" />\n    <title>Typing Indicator</title>\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n    <style>\n      html,\n      body {\n        margin: 0;\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n      }\n      body {\n        background: #000;\n      }\n      .hf-ui-demo-canvas {\n        position: relative;\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n        background: #000;\n      }\n      .hf-ti-wrap {\n        position: absolute;\n        left: 880px;\n        top: 490px;\n        font-size: 160px;\n      }\n      .hf-ti-bubble {\n        width: 1em;\n        height: 0.54em;\n        background: #242428;\n        border-radius: 0.274em;\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        gap: 0.081em;\n      }\n      .hf-ti-dot {\n        width: 0.137em;\n        height: 0.137em;\n        border-radius: 50%;\n        background: #8e8e93;\n        display: inline-block;\n      }\n      .hf-ti-tail1 {\n        position: absolute;\n        left: -0.016em;\n        bottom: -0.032em;\n        width: 0.145em;\n        height: 0.145em;\n        border-radius: 50%;\n        background: #242428;\n      }\n      .hf-ti-tail2 {\n        position: absolute;\n        left: -0.113em;\n        bottom: -0.113em;\n        width: 0.073em;\n        height: 0.073em;\n        border-radius: 50%;\n        background: #242428;\n      }\n    </style>\n  </head>\n  <body>\n    <div\n      id=\"hf-ti-demo-root\"\n      class=\"hf-ui-demo-canvas\"\n      data-composition-id=\"typing-indicator-demo\"\n      data-start=\"0\"\n      data-width=\"1920\"\n      data-height=\"1080\"\n      data-duration=\"4\"\n    >\n      <section\n        class=\"clip\"\n        data-start=\"0\"\n        data-duration=\"4\"\n        data-track-index=\"1\"\n        style=\"position: absolute; inset: 0\"\n      >\n        <div class=\"hf-ti-wrap\" id=\"hf-ti-demo-1\">\n          <div class=\"hf-ti-bubble\">\n            <span class=\"hf-ti-dot\"></span>\n            <span class=\"hf-ti-dot\"></span>\n            <span class=\"hf-ti-dot\"></span>\n          </div>\n          <div class=\"hf-ti-tail1\"></div>\n          <div class=\"hf-ti-tail2\"></div>\n        </div>\n      </section>\n    </div>\n\n    <script>\n      window.__timelines = window.__timelines || {};\n      var tl = gsap.timeline({ paused: true });\n\n      tl.set(\"#hf-ti-demo-1\", { autoAlpha: 0 }, 0.001);\n      /* pop-in as measured */\n      tl.fromTo(\n        \"#hf-ti-demo-1\",\n        { scale: 0.6, autoAlpha: 0.4 },\n        { scale: 1, autoAlpha: 1, duration: 0.1, ease: \"power2.out\" },\n        0.4,\n      );\n      /* bounded dot wave */\n      gsap.utils.toArray(\"#hf-ti-demo-1 .hf-ti-dot\").forEach(function (dot, i) {\n        tl.to(\n          dot,\n          { y: -10, duration: 0.28, ease: \"sine.inOut\", yoyo: true, repeat: 9 },\n          0.55 + i * 0.14,\n        );\n      });\n      tl.set(\"#hf-ti-demo-1\", { autoAlpha: 0 }, 3.7);\n      tl.set({}, {}, 4);\n\n      window.__timelines[\"typing-indicator-demo\"] = tl;\n    </script>\n  </body>\n</html>\n"}