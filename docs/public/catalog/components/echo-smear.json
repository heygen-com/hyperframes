{"html":"<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=1920, height=1080\" />\n    <title>Echo Smear — Demo</title>\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n    <style>\n      * {\n        margin: 0;\n        padding: 0;\n        box-sizing: border-box;\n      }\n      html,\n      body {\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n        background: #0b0c10;\n      }\n      #es-root {\n        position: relative;\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n        background: #0b0c10;\n      }\n      #es-word {\n        position: absolute;\n        left: 0;\n        top: 0;\n        width: 1920px;\n        height: 640px;\n      }\n      /* Targets are absolutely positioned and styled by class: the copies drop ids. */\n      .es-letter {\n        position: absolute;\n        display: block;\n        overflow: visible;\n      }\n      .es-logo {\n        position: absolute;\n        left: 0;\n        top: 0;\n        overflow: visible;\n      }\n    </style>\n  </head>\n  <body>\n    <div\n      id=\"es-root\"\n      data-composition-id=\"echo-smear-demo\"\n      data-width=\"1920\"\n      data-height=\"1080\"\n      data-fps=\"24\"\n      data-start=\"0\"\n      data-duration=\"5\"\n    >\n      <div id=\"es-word\"></div>\n    </div>\n    <script>\n      (function () {\n        function resolveFps(root, opts) {\n          var cfg = window.__HF_EXPORT_RENDER_SEEK_CONFIG;\n          var fps =\n            Number(opts.fps) ||\n            (cfg && Number(cfg.fps)) ||\n            Number(root && root.getAttribute(\"data-fps\")) ||\n            30;\n          return fps > 0 ? fps : 30;\n        }\n\n        function lerpTrack(track, step, t, out) {\n          var f = Math.max(0, Math.min(track.length - 1, t / step));\n          var i = Math.floor(f),\n            j = Math.min(track.length - 1, i + 1),\n            u = f - i;\n          var a = track[i],\n            b = track[j];\n          for (var k = 0; k < a.length; k++) out[k] = a[k] + (b[k] - a[k]) * u;\n          return out;\n        }\n\n        // Echo count for one frame: AE's formula (the half-frame travel of the measured point, gated by\n        // threshold/2), then raised so the element's farthest point moves at most edgeSpacing px between\n        // copies, then capped. The raise never turns a smear on; edgeSpacing 0 gives AE's exact count.\n        function count(move, extent, o) {\n          var n = move > o.threshold / 2 ? Math.round(move * (o.length / 100) * o.countMult) : 0;\n          if (n > 0 && o.edgeSpacing > 0) n = Math.max(n, Math.ceil(extent / o.edgeSpacing));\n          return Math.min(n, o.maxEchoes);\n        }\n\n        var IDENTITY = [1, 0, 0, 1, 0, 0];\n\n        // A computed `transform` as [a, b, c, d, e, f]: \"none\" is the identity; a matrix3d (or anything\n        // else) is null, because it has no 2D matrix.\n        function parseMatrix(css) {\n          if (!css || css === \"none\") return IDENTITY.slice();\n          var m = /^matrix\\(([^)]+)\\)$/.exec(css);\n          if (!m) return null;\n          var v = m[1].split(\",\").map(parseFloat);\n          return v.length === 6 && v.every(isFinite) ? v : null;\n        }\n\n        // The 2D part of any computed transform, and whether it is exactly 2D. A matrix3d keeps its own string\n        // for the copies; its x/y/scale/turn part (m11 m12 m21 m22 m41 m42) is what travel and extent read.\n        function matrixOf(css) {\n          var flat = parseMatrix(css);\n          if (flat) return { m: flat, flat: true };\n          var d = /^matrix3d\\(([^)]+)\\)$/.exec(css || \"\");\n          if (!d) return { m: IDENTITY.slice(), flat: true };\n          var v = d[1].split(\",\").map(parseFloat);\n          return { m: [v[0], v[1], v[4], v[5], v[12], v[13]], flat: false };\n        }\n\n        function multiply(a, b) {\n          return [\n            a[0] * b[0] + a[2] * b[1],\n            a[1] * b[0] + a[3] * b[1],\n            a[0] * b[2] + a[2] * b[3],\n            a[1] * b[2] + a[3] * b[3],\n            a[0] * b[4] + a[2] * b[5] + a[4],\n            a[1] * b[4] + a[3] * b[5] + a[5],\n          ];\n        }\n\n        // A computed length or percentage as CSS px: a percentage is a share of `reference` (the element's own\n        // box: its width for x, its height for y), a bare number or px is itself, anything else is 0.\n        function lengthPx(value, reference) {\n          var n = parseFloat(value);\n          if (!isFinite(n)) return 0;\n          return /%$/.test(value) ? (n * reference) / 100 : n;\n        }\n\n        // The individual CSS properties `translate`, `rotate` and `scale` apply before `transform`, about the same\n        // origin, as translate · rotate · scale. GSAP can drive them, and the browser leaves `transform` as\n        // `none` when it does. 2D only: a rotation about an axis, or a third component, is left out. `box` is\n        // [width, height] in CSS px, which a percentage translate is a share of.\n        function individualMatrix(translate, rotate, scale, box) {\n          box = box || [0, 0];\n          var m = IDENTITY.slice();\n          if (translate && translate !== \"none\") {\n            var t = translate.split(\" \");\n            m = multiply(m, [1, 0, 0, 1, lengthPx(t[0], box[0]), lengthPx(t[1], box[1])]);\n          }\n          var r = rotate && /^(-?[\\d.e+-]+)(deg|rad|turn|grad)$/.exec(rotate);\n          if (r) {\n            var unit = { deg: Math.PI / 180, rad: 1, turn: 2 * Math.PI, grad: Math.PI / 200 }[r[2]];\n            var q = parseFloat(r[1]) * unit;\n            m = multiply(m, [Math.cos(q), Math.sin(q), -Math.sin(q), Math.cos(q), 0, 0]);\n          }\n          if (scale && scale !== \"none\") {\n            var k = scale.split(\" \").map(function (part) {\n              var n = parseFloat(part);\n              return /%$/.test(part) ? n / 100 : n;\n            });\n            var kx = isFinite(k[0]) ? k[0] : 1;\n            m = multiply(m, [kx, 0, 0, isFinite(k[1]) ? k[1] : kx, 0, 0]);\n          }\n          return m;\n        }\n\n        // A point of the element's box, given as fractions of it, after its transform: the transform turns and\n        // scales about `origin` (CSS px from the box's top-left), then translates. AE measures a layer's origin,\n        // so a spinning layer registers travel; a box fraction lets a spin or squash count as motion.\n        function boxPoint(m, box, origin, fx, fy) {\n          var dx = fx * box[0] - origin[0],\n            dy = fy * box[1] - origin[1];\n          return [\n            origin[0] + m[0] * dx + m[2] * dy + m[4],\n            origin[1] + m[1] * dx + m[3] * dy + m[5],\n          ];\n        }\n\n        // How far the farthest corner of the box moves between two poses: what the copies have to cover.\n        var CORNERS = [\n          [0, 0],\n          [1, 0],\n          [0, 1],\n          [1, 1],\n        ];\n        function cornerShift(ma, mb, box, origin) {\n          var worst = 0;\n          for (var k = 0; k < 4; k++) {\n            var p = boxPoint(ma, box, origin, CORNERS[k][0], CORNERS[k][1]);\n            var q = boxPoint(mb, box, origin, CORNERS[k][0], CORNERS[k][1]);\n            worst = Math.max(worst, Math.hypot(p[0] - q[0], p[1] - q[1]));\n          }\n          return worst;\n        }\n\n        // An element's box in CSS px. SVG elements have no offsetWidth: fall back to the width/height\n        // attributes, then the computed size.\n        function boxOf(el) {\n          var cs = getComputedStyle(el);\n          return [\n            el.offsetWidth || parseFloat(el.getAttribute(\"width\")) || parseFloat(cs.width) || 0,\n            el.offsetHeight || parseFloat(el.getAttribute(\"height\")) || parseFloat(cs.height) || 0,\n          ];\n        }\n\n        function originOf(el, box) {\n          var o = getComputedStyle(el).transformOrigin.split(\" \").map(parseFloat);\n          return o.length >= 2 && isFinite(o[0]) && isFinite(o[1])\n            ? [o[0], o[1]]\n            : [box[0] / 2, box[1] / 2];\n        }\n\n        window.__echoSmear = {\n          count: count,\n          lerpTrack: lerpTrack,\n          parseMatrix: parseMatrix,\n          individualMatrix: individualMatrix,\n          boxPoint: boxPoint,\n        };\n\n        window.attachEchoSmear = function (selector, tl, opts) {\n          opts = opts || {};\n          var length = opts.length != null ? opts.length : 100;\n          var threshold = opts.threshold != null ? opts.threshold : 40;\n          var countMult = opts.countMult != null ? opts.countMult : 1;\n          var maxEchoes = opts.maxEchoes != null ? opts.maxEchoes : 60;\n\n          var targets = [];\n          (Array.isArray(selector) ? selector : [selector]).forEach(function (s) {\n            if (typeof s === \"string\") targets.push.apply(targets, document.querySelectorAll(s));\n            else if (s instanceof Element) targets.push(s);\n          });\n          // One group per element, and never one around a copy: a selector that also matches an earlier call's\n          // copies (they keep the target's classes) must not turn them into targets.\n          if (!window._hfEsAttached) window._hfEsAttached = new WeakSet();\n          targets = targets.filter(function (el, i) {\n            return (\n              targets.indexOf(el) === i && // named twice in this call\n              !window._hfEsAttached.has(el) &&\n              !el.closest(\"[data-hf-echo-group]\")\n            );\n          });\n          // The copies' group is an HTML element: inside an <svg> it would render nothing.\n          targets = targets.filter(function (el) {\n            if (!el.ownerSVGElement) return true;\n            console.warn(\n              \"echo-smear: \" +\n                (el.id || el.tagName) +\n                \" is inside an <svg>; attach to the <svg> itself. Skipped.\",\n            );\n            return false;\n          });\n          if (!targets.length) return;\n          var fd = 1 / resolveFps(targets[0].closest(\"[data-composition-id]\"), opts);\n          // Sample densely enough that sub-frame curves stay curves (AE evaluates each echo time exactly).\n          var step = fd / (opts.subframes || 8);\n          var mp = opts.measurePoint || [0.5, 0.5];\n          // AE's count only follows the origin's travel, so a spinning or scaling layer's outer edge leaves\n          // visible steps between copies. edgeSpacing (px) raises the count until the farthest point of the\n          // element moves at most that far between copies. Set 0 for AE's exact count.\n          var edgeSpacing = opts.edgeSpacing != null ? opts.edgeSpacing : 1.5;\n          // The sweep seeks without events: a composition's callbacks (audio cues, counters, other effects)\n          // would otherwise fire thousands of times at attach. Motion that is written FROM a callback (an\n          // onUpdate that sets a transform) is only recorded with callbacks: true.\n          var quiet = !opts.callbacks;\n\n          // Bake: one forward sweep, the resolved transform and opacity per target at every sample, plus\n          // the measured point. All of it is local to the element's own box, so motion that comes only from\n          // an ancestor is not this element's (attach to the ancestor).\n          var saved = tl.time();\n          var dur = tl.duration();\n          var samples = Math.ceil(dur / step) + 2;\n          var boxes = targets.map(boxOf);\n          var origins = targets.map(function (el, ti) {\n            return originOf(el, boxes[ti]);\n          });\n          var poses = targets.map(function () {\n            return [];\n          });\n          var centres = targets.map(function () {\n            return [];\n          });\n          var matrix3d = targets.map(function () {\n            return [];\n          });\n          // What else the timeline can write that a copy must show as it was: not interpolated, so each copy\n          // takes the nearest sample.\n          var LOOKS = [\"filter\", \"clipPath\", \"transformOrigin\"];\n          var looks = targets.map(function () {\n            return [];\n          });\n          // Everything a copy needs besides its pose is recorded in the sweep too, so a frame never depends\n          // on reading the target while it may not have rendered that time yet (a backward seek renders the\n          // snippet's own update tween before the target's): the group's visibility and the target's box.\n          var showing = targets.map(function () {\n            return [];\n          });\n          var boxAt = targets.map(function () {\n            return [];\n          });\n          var hosts = targets.map(function (el) {\n            return el.parentElement || (el.getRootNode && el.getRootNode().host) || null;\n          });\n          var api = window.__echoSmear;\n          api.baking = (api.baking || 0) + 1; // other attached smears skip their update while this one records\n          try {\n            for (var s = 0; s < samples; s++) {\n              tl.time(Math.min(s * step, dur), quiet);\n              for (var ti = 0; ti < targets.length; ti++) {\n                var cs = getComputedStyle(targets[ti]);\n                var resolved = matrixOf(cs.transform);\n                if (resolved.flat) {\n                  resolved.m = multiply(\n                    individualMatrix(cs.translate, cs.rotate, cs.scale, boxes[ti]),\n                    resolved.m,\n                  );\n                }\n                var opacity = parseFloat(cs.opacity);\n                poses[ti].push(resolved.m.concat([isFinite(opacity) ? opacity : 1]));\n                matrix3d[ti].push(resolved.flat ? null : cs.transform);\n                looks[ti].push(\n                  LOOKS.map(function (k) {\n                    return cs[k] || \"\";\n                  }),\n                );\n                centres[ti].push(boxPoint(resolved.m, boxes[ti], origins[ti], mp[0], mp[1]));\n                // Set only where the target differs from its parent: an explicit value would outlive an\n                // ancestor that hides later, like a clip that has ended.\n                var parentSees = hosts[ti] ? getComputedStyle(hosts[ti]).visibility : \"visible\";\n                showing[ti].push(cs.visibility === parentSees ? \"\" : cs.visibility);\n                // An <svg> root has no offset box: its copies keep the left/top/size they were cloned with.\n                var el0 = targets[ti];\n                boxAt[ti].push(\n                  el0.offsetLeft === undefined\n                    ? null\n                    : [\n                        el0.offsetLeft + \"px\",\n                        el0.offsetTop + \"px\",\n                        el0.offsetWidth + \"px\",\n                        el0.offsetHeight + \"px\",\n                      ],\n                );\n              }\n            }\n          } finally {\n            api.baking--;\n            tl.time(saved, quiet);\n          }\n\n          var MEDIA = \"video,audio,iframe\";\n\n          // A copy loses the `#id` rules that styled the original, so it carries the target's resolved style.\n          // Every copy of a target shares ONE class per element (a rule written once), instead of an inline\n          // style per copy: hundreds of copies would otherwise each parse a few hundred declarations.\n          // Visibility is not frozen: the group follows the target, so a target hidden at attach still smears.\n          function resolvedStyles(source, out, parentVisibility) {\n            var cs = getComputedStyle(source);\n            var text = \"\";\n            for (var i = 0; i < cs.length; i++) {\n              var value = cs.getPropertyValue(cs[i]);\n              var inherited = parentVisibility === undefined || value === parentVisibility;\n              if (cs[i] === \"visibility\" && inherited) continue;\n              text += cs[i] + \":\" + value + \";\";\n            }\n            // A copy is a still of one instant: a live transition or animation would carry it somewhere\n            // the timeline never sampled.\n            out.push(text + \"transition:none;animation:none;\");\n            // The copy holds an empty box where media was, so the media's own children have no counterpart.\n            if (source.matches && source.matches(MEDIA)) return out;\n            for (var c = 0; c < source.children.length; c++) {\n              resolvedStyles(source.children[c], out, cs.getPropertyValue(\"visibility\"));\n            }\n            return out;\n          }\n\n          // One rule per element of the target's subtree, kept as text nodes. They go in the target's own\n          // root: a shadow root is its own style scope, and the document's rules do not reach into it.\n          function sheetFor(el) {\n            var root = el.getRootNode ? el.getRootNode() : document;\n            var scope = root.nodeType === 11 ? root : document.head || document.documentElement;\n            var found = scope.querySelector && scope.querySelector(\"style#hf-es-styles\");\n            if (found) return found;\n            var made = document.createElement(\"style\");\n            made.id = \"hf-es-styles\";\n            scope.appendChild(made);\n            return made;\n          }\n          function writeRules(sheet, rules, texts, tag) {\n            for (var r = 0; r < texts.length; r++) {\n              var css = \".\" + tag + \"-\" + r + \"{\" + texts[r] + \"}\";\n              if (rules[r]) rules[r].data = css;\n              else sheet.appendChild((rules[r] = document.createTextNode(css)));\n            }\n          }\n          function classCopies(copy, tag, cursor) {\n            copy.setAttribute(\"class\", tag + \"-\" + cursor.i++);\n            for (var c = 0; c < copy.children.length; c++)\n              classCopies(copy.children[c], tag, cursor);\n          }\n\n          // Copies are stills, and the runtime does not manage media it did not mark: a live copy would show\n          // a frozen frame and fetch its source again. A box of the same size stands in for it.\n          function inertMedia(source, copy) {\n            var from = source.querySelectorAll(MEDIA);\n            var to = copy.querySelectorAll(MEDIA);\n            for (var m = 0; m < to.length; m++) {\n              var stand = document.createElement(\"div\");\n              stand.style.cssText =\n                \"display:inline-block;width:\" +\n                (from[m].offsetWidth || 0) +\n                \"px;height:\" +\n                (from[m].offsetHeight || 0) +\n                \"px;\";\n              to[m].parentNode.replaceChild(stand, to[m]);\n            }\n          }\n\n          var maximum = opts.operator !== \"normal\";\n          var cfg = {\n            threshold: threshold,\n            length: length,\n            countMult: countMult,\n            maxEchoes: maxEchoes,\n            edgeSpacing: edgeSpacing,\n          };\n          var pa = [0, 0, 0, 0, 0, 0, 1],\n            pb = [0, 0, 0, 0, 0, 0, 1],\n            p0 = [0, 0],\n            p1 = [0, 0];\n          // The copy count for one target at time t.\n          function countAt(st, t) {\n            lerpTrack(st.centres, step, t, p0);\n            lerpTrack(st.centres, step, t - fd / 2, p1);\n            var move = Math.hypot(p0[0] - p1[0], p0[1] - p1[1]);\n            var extent = 0;\n            if (edgeSpacing > 0) {\n              lerpTrack(st.poses, step, t, pa);\n              lerpTrack(st.poses, step, t - fd * (length / 100), pb);\n              extent = cornerShift(pa, pb, st.box, st.origin);\n            }\n            return count(move, extent, cfg);\n          }\n\n          if (!window._hfEsUid) window._hfEsUid = 0;\n          var state = [];\n          targets.forEach(function (el, ti) {\n            window._hfEsAttached.add(el);\n            var st = {\n              el: el,\n              poses: poses[ti],\n              centres: centres[ti],\n              matrix3d: matrix3d[ti],\n              looks: looks[ti],\n              showing: showing[ti],\n              boxAt: boxAt[ti],\n              box: boxes[ti],\n              origin: origins[ti],\n            };\n            // The recording already holds the whole trajectory, so the most copies this target ever shows is\n            // known now: build that many, not maxEchoes. A target that never smears gets nothing.\n            var peak = 0;\n            for (var t = 0; t <= dur; t += step) peak = Math.max(peak, countAt(st, t));\n            if (peak === 0) return;\n\n            // The copies sit in a zero-size group just before the target, so the target itself is untouched:\n            // it keeps its parent, its blend mode and its pointer events. Isolated, so the lighten between\n            // copies never mixes with the background.\n            var group = document.createElement(\"div\");\n            group.setAttribute(\"data-hf-echo-group\", \"\");\n            group.style.cssText =\n              \"position:absolute;left:0;top:0;width:0;height:0;isolation:isolate;pointer-events:none;\";\n            // The group is what the siblings stack against, so it takes the target's z-index.\n            var z = getComputedStyle(el).zIndex;\n            if (z && z !== \"auto\") group.style.zIndex = z;\n\n            var tag = \"hf-es\" + window._hfEsUid++;\n            var rules = [];\n            var sheet = sheetFor(el);\n            // A copy is a grandchild of its parent, and perspective reaches children only: each copy carries\n            // the parent's perspective in its own transform (the vanishing point is then the copy's own).\n            var host = el.parentElement || (el.getRootNode && el.getRootNode().host) || null;\n            var persp = host ? getComputedStyle(host).perspective : \"none\";\n            st.perspective = persp && persp !== \"none\" ? \"perspective(\" + persp + \") \" : \"\";\n            function snapshot() {\n              // A target hidden right now (an autoAlpha entrance) is read as shown, so the copies' own\n              // resolved style is not a hidden one; the inline value goes back exactly.\n              var hidden = getComputedStyle(el).visibility !== \"visible\";\n              var inline = el.style.getPropertyValue(\"visibility\");\n              var priority = el.style.getPropertyPriority(\"visibility\");\n              if (hidden) el.style.setProperty(\"visibility\", \"visible\", \"important\");\n              try {\n                writeRules(sheet, rules, resolvedStyles(el, []), tag);\n              } finally {\n                if (hidden) el.style.setProperty(\"visibility\", inline, priority);\n              }\n            }\n            snapshot();\n\n            var clones = [];\n            for (var i = 0; i < peak; i++) {\n              var c = el.cloneNode(true);\n              c.removeAttribute(\"id\");\n              [c]\n                .concat(\n                  Array.prototype.slice.call(\n                    c.querySelectorAll(\"[data-start],[data-duration],[data-track-index]\"),\n                  ),\n                )\n                .forEach(function (n) {\n                  n.removeAttribute(\"data-start\");\n                  n.removeAttribute(\"data-duration\");\n                  n.removeAttribute(\"data-track-index\");\n                });\n              c.querySelectorAll(\"[id]\").forEach(function (n) {\n                n.removeAttribute(\"id\");\n              });\n              c.setAttribute(\"aria-hidden\", \"true\");\n              inertMedia(el, c);\n              classCopies(c, tag, { i: 0 });\n              c.classList.add(\"es-clone\");\n              c.style.position = \"absolute\";\n              c.style.margin = \"0\";\n