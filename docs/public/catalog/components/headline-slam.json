{"html":"<!doctype html>\n<!--\n  headline-slam demo. This standalone composition mounts headline-slam.html\n  through data-composition-src. Non-default copy, accent index, and color\n  prove that all variables flow through the elastic host mount.\n-->\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=1920, height=1080\" />\n    <title>Headline Slam Demo</title>\n    <style>\n      * {\n        margin: 0;\n        padding: 0;\n        box-sizing: border-box;\n      }\n\n      html,\n      body {\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n        background: #0b0c0e;\n      }\n\n      #root {\n        --bg: #0b0c0e;\n        --fg: #f7f8fa;\n        --surface: #15181e;\n        --border: #343943;\n        --font-display: Inter, system-ui, sans-serif;\n        position: relative;\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n        background: radial-gradient(ellipse at 50% 44%, #171a21 0%, var(--bg) 72%);\n      }\n\n      .mount-card {\n        width: 80%;\n        height: 60%;\n        left: 10%;\n        top: 20%;\n        container-type: size;\n        overflow: hidden;\n        border: 1px solid rgba(247, 248, 250, 0.12);\n        border-radius: 32px;\n        background: color-mix(in srgb, var(--surface) 88%, transparent);\n        box-shadow: 0 54px 120px rgba(0, 0, 0, 0.46);\n      }\n    </style>\n  </head>\n  <body>\n    <div\n      id=\"root\"\n      data-composition-id=\"headline-slam-demo\"\n      data-start=\"0\"\n      data-width=\"1920\"\n      data-height=\"1080\"\n      data-duration=\"3.5\"\n      data-fps=\"30\"\n    >\n      <div\n        id=\"headline-slam-mount\"\n        class=\"mount-card clip\"\n        data-composition-id=\"headline-slam\"\n        data-composition-src=\"data:text/html;base64,\"\n       \n        data-start=\"0\"\n        data-duration=\"3.5\"\n        data-track-index=\"0\"\n        data-width=\"1536\"\n        data-height=\"648\"\n      ></div>\n    </div>\n\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n    <script>\n      window.__timelines = window.__timelines || {};\n      window.__timelines[\"headline-slam-demo\"] = gsap.timeline({ paused: true });\n    </script>\n  </body>\n</html>\n"}