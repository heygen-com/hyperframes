{"html":"<!doctype html>\n<!--\n  conic-progress-ring demo. This standalone composition mounts the primitive\n  through data-composition-src and supplies non-default values so the mount\n  path and every exposed variable are exercised together.\n-->\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=1920, height=1080\" />\n    <title>Conic Progress Ring Demo</title>\n    <style>\n      * {\n        margin: 0;\n        padding: 0;\n        box-sizing: border-box;\n      }\n\n      html,\n      body {\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n      }\n\n      #root {\n        --bg: #071018;\n        --fg: #f4f7fb;\n        --muted: #91a0b3;\n        --surface: #1b2938;\n        --border: rgba(244, 247, 251, 0.14);\n        --brand: #35d6a0;\n        --accent: #74b9ff;\n        --font-display: Inter, system-ui, sans-serif;\n        --font-body: Inter, system-ui, sans-serif;\n        --font-mono: ui-monospace, monospace;\n        --radius: 4cqh;\n        --space-1: 1cqh;\n        --space-2: 2cqh;\n        --space-3: 3cqh;\n        --dur-beat: 0.4s;\n        --ease-standard: cubic-bezier(0.215, 0.61, 0.355, 1);\n        --ease-emphasis: cubic-bezier(0.19, 1, 0.22, 1);\n        position: relative;\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n        background: var(--bg);\n      }\n\n      .mount-card {\n        position: absolute;\n        left: 29%;\n        top: 19%;\n        width: 42%;\n        height: 62%;\n        overflow: hidden;\n        border: 0.15cqh solid var(--border);\n        border-radius: var(--radius);\n        background: var(--bg);\n      }\n    </style>\n  </head>\n  <body>\n    <div\n      id=\"root\"\n      data-composition-id=\"conic-progress-ring-demo\"\n      data-start=\"0\"\n      data-width=\"1920\"\n      data-height=\"1080\"\n      data-duration=\"4\"\n      data-fps=\"30\"\n    >\n      <div\n        id=\"conic-progress-ring-mount\"\n        class=\"mount-card clip\"\n        data-composition-id=\"conic-progress-ring\"\n        data-composition-src=\"data:text/html;base64,\"\n       \n        data-start=\"0\"\n        data-duration=\"4\"\n        data-track-index=\"0\"\n        data-width=\"806\"\n        data-height=\"670\"\n      ></div>\n    </div>\n\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n    <script>\n      window.__timelines = window.__timelines || {};\n      window.__timelines[\"conic-progress-ring-demo\"] = gsap.timeline({ paused: true });\n    </script>\n  </body>\n</html>\n"}