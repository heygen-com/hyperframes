{"html":"<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n    <!--\n      cinemagraph — a still photograph with ONE living region.\n\n      The frame is a frozen scene; a single masked window keeps moving — the classic\n      cinemagraph gesture: the camera stops, the world keeps breathing. The living\n      region here is the steam over a cup, drawn deterministically on a canvas from\n      the seek time alone, with a period that divides the duration, so the last\n      frame matches the first and the render loops seamlessly.\n\n      Using it with real media: keep the structure and swap the layers —\n        1. Put your looping <video> (or the animated source) as the BASE layer.\n        2. Put a freeze-frame still of it (an <img>) ABOVE, full-frame.\n        3. Move #cmg-window (the feathered mask) onto the still so the window\n           reveals the video beneath, and delete the placeholder scene + canvas.\n      One living region per frame. Two is a gif.\n    -->\n    <style>\n      *,\n      *::before,\n      *::after {\n        margin: 0;\n        padding: 0;\n        box-sizing: border-box;\n      }\n      body {\n        background: #0b0e14;\n        overflow: hidden;\n      }\n      #root-cinemagraph {\n        position: relative;\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n        background: #0b0e14;\n        --hf-ink: #f8fafc;\n      }\n      /* ---- the still photograph (placeholder scene, monochrome ink ramp) ---- */\n      .cmg-photo {\n        position: absolute;\n        inset: 0;\n      }\n      /* window light falling across the scene */\n      .cmg-lightfall {\n        position: absolute;\n        inset: 0;\n        background: linear-gradient(\n          115deg,\n          color-mix(in srgb, var(--hf-ink) 8%, transparent) 0%,\n          transparent 46%\n        );\n      }\n      /* table surface */\n      .cmg-table {\n        position: absolute;\n        left: 0;\n        right: 0;\n        bottom: 0;\n        height: 320px;\n        background: color-mix(in srgb, var(--hf-ink) 8%, transparent);\n        border-top: 1px solid color-mix(in srgb, var(--hf-ink) 14%, transparent);\n      }\n      /* window frame in the far wall */\n      .cmg-pane {\n        position: absolute;\n        left: 1210px;\n        top: 130px;\n        width: 420px;\n        height: 520px;\n        background: color-mix(in srgb, var(--hf-ink) 18%, transparent);\n        border: 1px solid color-mix(in srgb, var(--hf-ink) 14%, transparent);\n      }\n      .cmg-pane::before,\n      .cmg-pane::after {\n        content: \"\";\n        position: absolute;\n        background: color-mix(in srgb, var(--hf-ink) 14%, transparent);\n      }\n      .cmg-pane::before {\n        left: 50%;\n        top: 0;\n        bottom: 0;\n        width: 1px;\n      }\n      .cmg-pane::after {\n        top: 50%;\n        left: 0;\n        right: 0;\n        height: 1px;\n      }\n      /* saucer + cup, the photograph's subject */\n      .cmg-saucer {\n        position: absolute;\n        left: 760px;\n        bottom: 236px;\n        width: 400px;\n        height: 56px;\n        border-radius: 50%;\n        background: color-mix(in srgb, var(--hf-ink) 45%, transparent);\n      }\n      .cmg-cup {\n        position: absolute;\n        left: 830px;\n        bottom: 262px;\n        width: 260px;\n        height: 190px;\n        border-radius: 0 0 118px 118px;\n        background: color-mix(in srgb, var(--hf-ink) 72%, transparent);\n      }\n      .cmg-cup::after {\n        content: \"\";\n        position: absolute;\n        right: -64px;\n        top: 18px;\n        width: 88px;\n        height: 96px;\n        border: 22px solid color-mix(in srgb, var(--hf-ink) 72%, transparent);\n        border-radius: 50%;\n      }\n      .cmg-rim {\n        position: absolute;\n        left: 822px;\n        bottom: 436px;\n        width: 276px;\n        height: 34px;\n        border-radius: 50%;\n        background: color-mix(in srgb, var(--hf-ink) 45%, transparent);\n      }\n      /* a closed book beside the cup */\n      .cmg-book {\n        position: absolute;\n        left: 1180px;\n        bottom: 250px;\n        width: 330px;\n        height: 44px;\n        background: color-mix(in srgb, var(--hf-ink) 18%, transparent);\n        border: 1px solid color-mix(in srgb, var(--hf-ink) 14%, transparent);\n        transform: rotate(-2deg);\n      }\n      .cmg-book::after {\n        content: \"\";\n        position: absolute;\n        left: 14px;\n        right: 14px;\n        top: 12px;\n        height: 1px;\n        background: color-mix(in srgb, var(--hf-ink) 14%, transparent);\n      }\n      /* skeleton caption lines, bottom left — content lives here */\n      .cmg-line {\n        position: absolute;\n        left: 160px;\n        height: 22px;\n        border-radius: 11px;\n        background: color-mix(in srgb, var(--hf-ink) 18%, transparent);\n      }\n      /* ---- the ONE living region: a feathered window where steam moves ---- */\n      #cmg-window {\n        position: absolute;\n        left: 790px;\n        bottom: 430px;\n        width: 340px;\n        height: 420px;\n        -webkit-mask-image: radial-gradient(ellipse 50% 50% at 50% 55%, #000 55%, transparent 78%);\n        mask-image: radial-gradient(ellipse 50% 50% at 50% 55%, #000 55%, transparent 78%);\n      }\n      #cmg-canvas {\n        position: absolute;\n        inset: 0;\n        width: 340px;\n        height: 420px;\n      }\n      /* still vignette over everything, part of the photograph */\n      .cmg-vignette {\n        position: absolute;\n        inset: 0;\n        background: radial-gradient(\n          ellipse 78% 72% at 50% 46%,\n          transparent 62%,\n          rgba(4, 6, 10, 0.5) 100%\n        );\n        pointer-events: none;\n      }\n    </style>\n  </head>\n  <body>\n    <div\n      id=\"root-cinemagraph\"\n      data-composition-id=\"cinemagraph\"\n      data-start=\"0\"\n      data-duration=\"10\"\n      data-width=\"1920\"\n      data-height=\"1080\"\n    >\n      <div class=\"cmg-photo\" id=\"cmg-photo\">\n        <div class=\"cmg-lightfall\"></div>\n        <div class=\"cmg-pane\"></div>\n        <div class=\"cmg-table\"></div>\n        <div class=\"cmg-saucer\"></div>\n        <div class=\"cmg-cup\"></div>\n        <div class=\"cmg-rim\"></div>\n        <div class=\"cmg-book\"></div>\n        <div class=\"cmg-line\" style=\"bottom: 150px; width: 460px\"></div>\n        <div class=\"cmg-line\" style=\"bottom: 108px; width: 300px\"></div>\n      </div>\n      <div id=\"cmg-window\">\n        <canvas id=\"cmg-canvas\" width=\"340\" height=\"420\"></canvas>\n      </div>\n      <div class=\"cmg-vignette\"></div>\n      <div\n        id=\"drv-cinemagraph\"\n        class=\"clip\"\n        data-start=\"0\"\n        data-duration=\"10\"\n        data-track-index=\"0\"\n        style=\"position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none\"\n      ></div>\n    </div>\n    <script>\n      (function () {\n        window.__timelines = window.__timelines || {};\n\n        // Seeded PRNG — never Math.random()\n        function mulberry32(a) {\n          return function () {\n            a |= 0;\n            a = (a + 0x6d2b79f5) | 0;\n            var t = Math.imul(a ^ (a >>> 15), 1 | a);\n            t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;\n            return ((t ^ (t >>> 14)) >>> 0) / 4294967296;\n          };\n        }\n        var rng = mulberry32(1897);\n\n        var DUR = 10;\n        // Each wisp cycles an integer number of times over DUR, so the frame at\n        // t = DUR equals the frame at t = 0 and the render loops seamlessly.\n        var WISPS = [];\n        for (var i = 0; i < 14; i++) {\n          WISPS.push({\n            x0: 90 + rng() * 160, // birth x inside the window\n            cycles: 1 + Math.floor(rng() * 2), // 1 or 2 full rises over DUR\n            phase: rng(), // where in its cycle it starts\n            sway: 14 + rng() * 26, // horizontal sway amplitude\n            swayFreq: 1 + Math.floor(rng() * 2), // integer — keeps the loop seam clean\n            width: 10 + rng() * 22, // wisp thickness\n            rise: 300 + rng() * 80, // how far it climbs before dissolving\n            alpha: 0.05 + rng() * 0.09,\n          });\n        }\n\n        var canvas = document.getElementById(\"cmg-canvas\");\n        var ctx = canvas.getContext(\"2d\");\n        var W = 340,\n          H = 420;\n\n        // State proxy — GSAP animates t, the render function reads it.\n        var st = { t: 0 };\n\n        function renderScene() {\n          ctx.clearRect(0, 0, W, H);\n          for (var i = 0; i < WISPS.length; i++) {\n            var w = WISPS[i];\n            // p in [0,1): this wisp's position in its own rise cycle\n            var p = (st.t / DUR) * w.cycles + w.phase;\n            p = p - Math.floor(p);\n            var y = H - 40 - p * w.rise;\n            var sway = Math.sin(2 * Math.PI * (p * w.swayFreq + w.phase)) * w.sway * p;\n            var x = w.x0 + sway;\n            // born faint, fullest mid-rise, dissolves at the top\n            var a = w.alpha * Math.sin(Math.PI * p);\n            var r = w.width * (0.7 + p * 1.6);\n            var g = ctx.createRadialGradient(x, y, 0, x, y, r * 2.4);\n            g.addColorStop(0, \"rgba(248,250,252,\" + a.toFixed(4) + \")\");\n            g.addColorStop(1, \"rgba(248,250,252,0)\");\n            ctx.fillStyle = g;\n            ctx.beginPath();\n            ctx.ellipse(x, y, r * 1.1, r * 2.2, sway * 0.004, 0, 2 * Math.PI);\n            ctx.fill();\n          }\n        }\n\n        var tl = gsap.timeline({ paused: true });\n        tl.to(st, { t: DUR, duration: DUR, ease: \"none\" }, 0);\n\n        window.__timelines[\"cinemagraph\"] = tl;\n\n        // Render from the timeline only — no requestAnimationFrame.\n        tl.eventCallback(\"onUpdate\", renderScene);\n        renderScene();\n      })();\n    </script>\n  </body>\n</html>\n"}