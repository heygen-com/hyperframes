{"html":"<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n    <style>\n      *,\n      *::before,\n      *::after {\n        box-sizing: border-box;\n      }\n\n      html,\n      body,\n      #snow-demo {\n        width: 1920px;\n        height: 1080px;\n        margin: 0;\n        overflow: hidden;\n      }\n\n      #snow-demo-backdrop,\n      #snow-demo-overlay {\n        position: absolute;\n        inset: 0;\n      }\n\n      #snow-demo-backdrop {\n        background: linear-gradient(180deg, #1c2b3d 0%, #0d1620 62%, #06090f 100%);\n      }\n    </style>\n  </head>\n  <body>\n    <div\n      id=\"snow-demo\"\n      data-composition-id=\"snow-demo\"\n      data-start=\"0\"\n      data-duration=\"6\"\n      data-width=\"1920\"\n      data-height=\"1080\"\n    >\n      <div\n        id=\"snow-demo-backdrop\"\n        class=\"clip\"\n        data-start=\"0\"\n        data-duration=\"6\"\n        data-track-index=\"0\"\n      ></div>\n      <div\n        id=\"snow-demo-overlay\"\n        data-composition-id=\"snow\"\n        data-composition-src=\"data:text/html;base64,\"\n        data-start=\"0\"\n        data-duration=\"6\"\n        data-track-index=\"1\"\n        data-width=\"1920\"\n        data-height=\"1080\"\n      ></div>\n    </div>\n\n    <script>\n      window.__timelines = window.__timelines || {};\n      var tl = gsap.timeline({ paused: true });\n      tl.to({}, { duration: 6, ease: \"none\" }, 0);\n      window.__timelines[\"snow-demo\"] = tl;\n    </script>\n  </body>\n</html>\n"}