{"html":"<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n    <style>\n      *,\n      *::before,\n      *::after {\n        box-sizing: border-box;\n      }\n\n      html,\n      body,\n      #starfield-demo {\n        width: 1920px;\n        height: 1080px;\n        margin: 0;\n        overflow: hidden;\n      }\n\n      #starfield-demo-backdrop {\n        position: absolute;\n        inset: 0;\n        background: #07080b;\n      }\n\n      #starfield-demo-title {\n        position: absolute;\n        inset: 0;\n        display: flex;\n        flex-direction: column;\n        align-items: center;\n        justify-content: center;\n        font-family: Inter, system-ui, sans-serif;\n        text-align: center;\n        -webkit-font-smoothing: antialiased;\n      }\n\n      #starfield-demo-title h1 {\n        margin: 0;\n        font-size: 144px;\n        font-weight: 600;\n        letter-spacing: -0.04em;\n        line-height: 1;\n        color: #f4f4f5;\n      }\n\n      #starfield-demo-title p {\n        margin: 24px 0 0;\n        font-size: 40px;\n        font-weight: 400;\n        letter-spacing: -0.01em;\n        color: #a1a1aa;\n      }\n\n      #starfield-demo-title time {\n        margin-top: 40px;\n        font-size: 24px;\n        font-weight: 500;\n        letter-spacing: 0.02em;\n        color: #71717a;\n      }\n\n      #starfield-demo-overlay {\n        position: absolute;\n        inset: 0;\n      }\n    </style>\n  </head>\n  <body>\n    <div\n      id=\"starfield-demo\"\n      data-composition-id=\"starfield-demo\"\n      data-start=\"0\"\n      data-duration=\"6\"\n      data-width=\"1920\"\n      data-height=\"1080\"\n    >\n      <div\n        id=\"starfield-demo-backdrop\"\n        class=\"clip\"\n        data-start=\"0\"\n        data-duration=\"6\"\n        data-track-index=\"0\"\n      ></div>\n      <div\n        id=\"starfield-demo-title\"\n        class=\"clip\"\n        data-start=\"0\"\n        data-duration=\"6\"\n        data-track-index=\"1\"\n      >\n        <h1>Northstar</h1>\n        <p>Offline maps for the backcountry</p>\n        <time datetime=\"2026-10-14\">October 14, 2026</time>\n      </div>\n      <div\n        id=\"starfield-demo-overlay\"\n        data-composition-id=\"starfield\"\n        data-composition-src=\"data:text/html;base64,\"\n        data-start=\"0\"\n        data-duration=\"6\"\n        data-track-index=\"2\"\n       \n        data-width=\"1920\"\n        data-height=\"1080\"\n      ></div>\n    </div>\n\n    <script>\n      window.__timelines = window.__timelines || {};\n      var tl = gsap.timeline({ paused: true });\n      tl.to({}, { duration: 6, ease: \"none\" }, 0);\n      window.__timelines[\"starfield-demo\"] = tl;\n    </script>\n  </body>\n</html>\n"}