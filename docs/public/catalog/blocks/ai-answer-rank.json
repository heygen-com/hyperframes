{"html":"<!doctype html>\n<!--\n  ai-answer-rank: \"Is your brand in the AI answer?\"\n\n  A mock AI chat card for answer-engine and AI-visibility marketing. The\n  question types into the user's bubble, the assistant answers with a ranked\n  list of three picks, holds, then re-ranks: the promoted brand slides into\n  its slot, the rows below it step down, the last one drops out of the top\n  three, and the brand row lands with the one accent highlight and a check.\n\n  The UI is placeholder material: ink at alpha steps over the ground, logos as\n  rounded-square monograms, descriptions as skeleton rules. Accent lands on\n  the brand row only.\n\n  Rank numbers belong to the slots, not the rows, so a row that moves keeps\n  the list numbered 1-3 without swapping any text.\n-->\n<html\n  lang=\"en\"\n  data-composition-variables='[{\"id\":\"prompt\",\"type\":\"string\",\"role\":\"content\",\"label\":\"Prompt\",\"description\":\"The question typed into the user bubble. Up to about 60 characters keeps it on one or two lines.\",\"default\":\"What&#39;s the best CRM for a small team?\"},{\"id\":\"lead\",\"type\":\"string\",\"role\":\"content\",\"label\":\"Answer lead-in\",\"description\":\"The assistant line above the ranked list.\",\"default\":\"Here are the top picks:\"},{\"id\":\"rowA\",\"type\":\"string\",\"role\":\"content\",\"label\":\"Pick 1\",\"description\":\"First pick in the original answer: a product other than the brand this video promotes.\",\"portrays\":[\"competitor_name\"],\"default\":\"Brand A\"},{\"id\":\"rowB\",\"type\":\"string\",\"role\":\"content\",\"label\":\"Pick 2\",\"description\":\"Second pick in the original answer: a product other than the brand this video promotes.\",\"portrays\":[\"competitor_name\"],\"default\":\"Brand B\"},{\"id\":\"rowC\",\"type\":\"string\",\"role\":\"content\",\"label\":\"Pick 3\",\"description\":\"Third pick in the original answer. It drops out of the top three when the brand lands.\",\"portrays\":[\"competitor_name\"],\"default\":\"Brand C\"},{\"id\":\"brand\",\"type\":\"string\",\"role\":\"content\",\"label\":\"Brand\",\"description\":\"The brand this video promotes, by its real name. It slides into the answer and takes the highlight.\",\"portrays\":[\"subject_name\"],\"default\":\"Your brand\"},{\"id\":\"brandRank\",\"type\":\"enum\",\"role\":\"content\",\"label\":\"Brand rank\",\"description\":\"The slot the brand lands in. Picks at and below it step down one place.\",\"portrays\":[\"recommended_position\"],\"default\":\"1\",\"options\":[{\"value\":\"1\",\"label\":\"1st\"},{\"value\":\"2\",\"label\":\"2nd\"},{\"value\":\"3\",\"label\":\"3rd\"}]},{\"id\":\"accent\",\"type\":\"color\",\"role\":\"style\",\"label\":\"Accent\",\"description\":\"Highlight, monogram and check on the brand row, the one accent element.\",\"default\":\"#16a34a\"},{\"id\":\"ink\",\"type\":\"color\",\"role\":\"style\",\"label\":\"Ink\",\"description\":\"Text colour; every placeholder surface is this ink at an alpha step.\",\"default\":\"#18181b\"},{\"id\":\"ground\",\"type\":\"color\",\"role\":\"style\",\"label\":\"Ground\",\"description\":\"Chat card surface; the page around it is the ground tinted toward the ink.\",\"default\":\"#fcfcfb\"}]'\n>\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=1080, height=1080\" />\n    <title>AI Answer Rank</title>\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n    <style>\n      * {\n        margin: 0;\n        padding: 0;\n        box-sizing: border-box;\n      }\n      html,\n      body {\n        width: 1080px;\n        height: 1080px;\n        overflow: hidden;\n        background: #efefee;\n      }\n      #aar-root {\n        --aar-ink: #18181b;\n        --aar-ground: #fcfcfb;\n        --aar-accent: #16a34a;\n        --aar-l1: color-mix(in srgb, var(--aar-ink) 72%, transparent);\n        --aar-l2: color-mix(in srgb, var(--aar-ink) 45%, transparent);\n        --aar-l3: color-mix(in srgb, var(--aar-ink) 18%, transparent);\n        --aar-l4: color-mix(in srgb, var(--aar-ink) 8%, transparent);\n        --aar-hair: color-mix(in srgb, var(--aar-ink) 14%, transparent);\n        position: relative;\n        width: 1080px;\n        height: 1080px;\n        overflow: hidden;\n        background: color-mix(in srgb, var(--aar-ink) 6%, var(--aar-ground));\n        color: var(--aar-ink);\n        font-family: Inter, ui-sans-serif, system-ui, sans-serif;\n      }\n      #aar-scene {\n        position: absolute;\n        inset: 0;\n        display: flex;\n        align-items: center;\n        justify-content: center;\n      }\n      #aar-card {\n        width: 920px;\n        padding: 56px 56px 16px;\n        border-radius: 44px;\n        background: var(--aar-ground);\n        border: 1px solid var(--aar-hair);\n        box-shadow:\n          0 2px 6px rgba(0, 0, 0, 0.04),\n          0 30px 80px rgba(0, 0, 0, 0.1);\n        display: flex;\n        flex-direction: column;\n      }\n\n      /* the bubble is sized by an invisible copy of the whole prompt, so typing never reflows the card */\n      #aar-bubble {\n        position: relative;\n        align-self: flex-end;\n        max-width: 720px;\n        padding: 24px 32px;\n        border-radius: 32px 32px 10px 32px;\n        background: var(--aar-l4);\n        font-size: 32px;\n        line-height: 44px;\n        letter-spacing: -0.2px;\n        transform-origin: 100% 100%;\n      }\n      #aar-sizer {\n        visibility: hidden;\n      }\n      #aar-typing {\n        position: absolute;\n        left: 32px;\n        right: 32px;\n        top: 24px;\n      }\n      #aar-caret {\n        display: inline-block;\n        width: 3px;\n        height: 34px;\n        margin-left: 2px;\n        border-radius: 2px;\n        background: var(--aar-ink);\n        vertical-align: -6px;\n      }\n\n      #aar-answer {\n        position: relative;\n        margin-top: 48px;\n      }\n      #aar-lead {\n        display: flex;\n        align-items: center;\n        gap: 16px;\n        height: 48px;\n        font-size: 34px;\n        font-weight: 600;\n        letter-spacing: -0.4px;\n      }\n      #aar-star {\n        flex: 0 0 auto;\n        width: 30px;\n        height: 30px;\n      }\n      #aar-star path {\n        fill: var(--aar-ink);\n      }\n      .aar-w {\n        opacity: 0;\n      }\n      #aar-thinking {\n        position: absolute;\n        left: 4px;\n        top: 17px;\n        display: flex;\n        gap: 10px;\n      }\n      .aar-dot {\n        width: 14px;\n        height: 14px;\n        border-radius: 50%;\n        background: var(--aar-l2);\n      }\n\n      /* 40px of runway under slot three, masked, so the pick pushed out fades instead of being cut */\n      #aar-list {\n        position: relative;\n        height: 448px;\n        margin-top: 28px;\n        overflow: hidden;\n        -webkit-mask-image: linear-gradient(to bottom, #000 408px, transparent 448px);\n        mask-image: linear-gradient(to bottom, #000 408px, transparent 448px);\n      }\n      .aar-rank {\n        position: absolute;\n        left: 0;\n        width: 44px;\n        height: 124px;\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        font-size: 30px;\n        font-weight: 600;\n        font-variant-numeric: tabular-nums;\n        color: var(--aar-l1);\n      }\n      .aar-row {\n        position: absolute;\n        left: 68px;\n        right: 0;\n        height: 124px;\n        display: flex;\n        align-items: center;\n        gap: 26px;\n        padding: 0 28px;\n        border-radius: 28px;\n        border: 1.5px solid var(--aar-hair);\n      }\n      .aar-hl {\n        position: absolute;\n        inset: -1.5px;\n        border-radius: 28px;\n        border: 3px solid var(--aar-accent);\n        background: color-mix(in srgb, var(--aar-accent) 9%, transparent);\n      }\n      .aar-tile {\n        position: relative;\n        flex: 0 0 auto;\n        width: 68px;\n        height: 68px;\n        border-radius: 18px;\n        background: var(--aar-l1);\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        overflow: hidden;\n      }\n      .aar-tile-accent {\n        position: absolute;\n        inset: 0;\n        background: var(--aar-accent);\n      }\n      .aar-mono {\n        position: relative;\n        color: var(--aar-ground);\n        font-size: 26px;\n        font-weight: 700;\n        letter-spacing: 0.5px;\n      }\n      .aar-meta {\n        position: relative;\n        flex: 1 1 auto;\n        min-width: 0;\n      }\n      .aar-name {\n        font-size: 36px;\n        font-weight: 600;\n        line-height: 44px;\n        letter-spacing: -0.5px;\n        white-space: nowrap;\n        overflow: hidden;\n        text-overflow: ellipsis;\n      }\n      .aar-skel {\n        height: 12px;\n        margin-top: 12px;\n        border-radius: 6px;\n        background: var(--aar-l3);\n      }\n      #aar-check {\n        position: relative;\n        flex: 0 0 auto;\n        width: 56px;\n        height: 56px;\n      }\n      #aar-check circle {\n        fill: var(--aar-accent);\n      }\n      #aar-check-path {\n        fill: none;\n        stroke: var(--aar-ground);\n        stroke-width: 5;\n        stroke-linecap: round;\n        stroke-linejoin: round;\n      }\n      .aar-hidden {\n        opacity: 0;\n        visibility: hidden;\n      }\n    </style>\n  </head>\n  <body>\n    <div\n      id=\"aar-root\"\n      data-composition-id=\"ai-answer-rank\"\n      data-start=\"0\"\n      data-width=\"1080\"\n      data-height=\"1080\"\n      data-duration=\"9\"\n    >\n      <section id=\"aar-scene\" class=\"clip\" data-start=\"0\" data-duration=\"9\" data-track-index=\"1\">\n        <div id=\"aar-card\" class=\"aar-hidden\">\n          <div id=\"aar-bubble\" class=\"aar-hidden\">\n            <span id=\"aar-sizer\">What's the best CRM for a small team?</span>\n            <div id=\"aar-typing\"><span id=\"aar-typed\"></span><span id=\"aar-caret\"></span></div>\n          </div>\n\n          <div id=\"aar-answer\">\n            <div id=\"aar-thinking\" class=\"aar-hidden\">\n              <div class=\"aar-dot\"></div>\n              <div class=\"aar-dot\"></div>\n              <div class=\"aar-dot\"></div>\n            </div>\n            <div id=\"aar-lead\">\n              <svg id=\"aar-star\" class=\"aar-hidden\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n                <path\n                  d=\"M12 0 C12.9 7 17 11.1 24 12 C17 12.9 12.9 17 12 24 C11.1 17 7 12.9 0 12 C7 11.1 11.1 7 12 0 Z\"\n                />\n              </svg>\n              <span id=\"aar-lead-text\">Here are the top picks:</span>\n            </div>\n\n            <div id=\"aar-list\">\n              <div class=\"aar-rank aar-hidden\" id=\"aar-rank-1\" style=\"top: 0\">1</div>\n              <div class=\"aar-rank aar-hidden\" id=\"aar-rank-2\" style=\"top: 142px\">2</div>\n              <div class=\"aar-rank aar-hidden\" id=\"aar-rank-3\" style=\"top: 284px\">3</div>\n\n              <div\n                class=\"aar-row aar-hidden\"\n                id=\"aar-row-a\"\n                data-layout-allow-overflow\n                style=\"top: 0\"\n              >\n                <div class=\"aar-tile\"><span class=\"aar-mono\">BA</span></div>\n                <div class=\"aar-meta\">\n                  <div class=\"aar-name\">Brand A</div>\n                  <div class=\"aar-skel\" style=\"width: 58%\"></div>\n                </div>\n              </div>\n              <div\n                class=\"aar-row aar-hidden\"\n                id=\"aar-row-b\"\n                data-layout-allow-overflow\n                style=\"top: 142px\"\n              >\n                <div class=\"aar-tile\"><span class=\"aar-mono\">BB</span></div>\n                <div class=\"aar-meta\">\n                  <div class=\"aar-name\">Brand B</div>\n                  <div class=\"aar-skel\" style=\"width: 44%\"></div>\n                </div>\n              </div>\n              <div\n                class=\"aar-row aar-hidden\"\n                id=\"aar-row-c\"\n                data-layout-allow-overflow\n                style=\"top: 284px\"\n              >\n                <div class=\"aar-tile\"><span class=\"aar-mono\">BC</span></div>\n                <div class=\"aar-meta\">\n                  <div class=\"aar-name\">Brand C</div>\n                  <div class=\"aar-skel\" style=\"width: 51%\"></div>\n                </div>\n              </div>\n\n              <div\n                class=\"aar-row aar-hidden\"\n                id=\"aar-row-brand\"\n                data-layout-allow-overflow\n                style=\"top: 0\"\n              >\n                <div class=\"aar-hl aar-hidden\" id=\"aar-hl\"></div>\n                <div class=\"aar-tile\">\n                  <div class=\"aar-tile-accent aar-hidden\" id=\"aar-tile-accent\"></div>\n                  <span class=\"aar-mono\">YB</span>\n                </div>\n                <div class=\"aar-meta\">\n                  <div class=\"aar-name\">Your brand</div>\n                  <div class=\"aar-skel\" style=\"width: 62%\"></div>\n                </div>\n                <svg id=\"aar-check\" class=\"aar-hidden\" viewBox=\"0 0 56 56\" aria-hidden=\"true\">\n                  <circle cx=\"28\" cy=\"28\" r=\"28\" />\n                  <path id=\"aar-check-path\" d=\"M17 29 L24.5 36.5 L39 21\" />\n                </svg>\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>\n    </div>\n\n    <script>\n      (function () {\n        \"use strict\";\n\n        var vars =\n          window.__hyperframes && typeof window.__hyperframes.getVariables === \"function\"\n            ? window.__hyperframes.getVariables()\n            : {};\n\n        function text(value, fallback, max) {\n          if (typeof value !== \"string\") return fallback;\n          var t = value.trim();\n          if (!t) return fallback;\n          return t.length > max ? t.slice(0, max) : t;\n        }\n        function color(value, fallback) {\n          if (typeof value !== \"string\") return fallback;\n          var c = value.trim();\n          return c && CSS.supports(\"color\", c) ? c : fallback;\n        }\n        function monogram(name) {\n          var words = name.split(/\\s+/).filter(Boolean);\n          var letters =\n            words.length > 1 ? words[0][0] + words[words.length - 1][0] : name.slice(0, 1);\n          return letters.toUpperCase();\n        }\n\n        var root = document.getElementById(\"aar-root\");\n        root.style.setProperty(\"--aar-ink\", color(vars.ink, \"#18181b\"));\n        root.style.setProperty(\"--aar-ground\", color(vars.ground, \"#fcfcfb\"));\n        root.style.setProperty(\"--aar-accent\", color(vars.accent, \"#16a34a\"));\n\n        var prompt = text(vars.prompt, \"What's the best CRM for a small team?\", 90);\n        var lead = text(vars.lead, \"Here are the top picks:\", 48);\n        var names = [\n          text(vars.rowA, \"Brand A\", 32),\n          text(vars.rowB, \"Brand B\", 32),\n          text(vars.rowC, \"Brand C\", 32),\n        ];\n        var brand = text(vars.brand, \"Your brand\", 32);\n        var slot = [\"1\", \"2\", \"3\"].indexOf(String(vars.brandRank));\n        if (slot < 0) slot = 0;\n\n        var SLOT = 142;\n        var rows = [\"#aar-row-a\", \"#aar-row-b\", \"#aar-row-c\"].map(function (sel, i) {\n          var el = document.querySelector(sel);\n          el.querySelector(\".aar-name\").textContent = names[i];\n          el.querySelector(\".aar-mono\").textContent = monogram(names[i]);\n          return el;\n        });\n        var brandRow = document.getElementById(\"aar-row-brand\");\n        brandRow.querySelector(\".aar-name\").textContent = brand;\n        brandRow.querySelector(\".aar-mono\").textContent = monogram(brand);\n        brandRow.style.top = slot * SLOT + \"px\";\n\n        document.getElementById(\"aar-sizer\").textContent = prompt;\n        var leadEl = document.getElementById(\"aar-lead-text\");\n        leadEl.textContent = \"\";\n        var words = lead.split(/\\s+/).map(function (word, i) {\n          if (i > 0) leadEl.appendChild(document.createTextNode(\" \"));\n          var span = document.createElement(\"span\");\n          span.className = \"aar-w\";\n          span.textContent = word;\n          leadEl.appendChild(span);\n          return span;\n        });\n\n        var checkPath = document.getElementById(\"aar-check-path\");\n        var checkLen = checkPath.getTotalLength();\n        checkPath.style.strokeDasharray = String(checkLen);\n\n        window.__timelines = window.__timelines || {};\n        var tl = gsap.timeline({ paused: true });\n\n        tl.fromTo(\n          \"#aar-card\",\n          { autoAlpha: 0, y: 40 },\n          { autoAlpha: 1, y: 0, duration: 0.6, ease: \"power3.out\" },\n          0.1,\n        );\n        tl.fromTo(\n          \"#aar-bubble\",\n          { autoAlpha: 0, scale: 0.9 },\n          { autoAlpha: 1, scale: 1, duration: 0.3, ease: \"back.out(1.6)\" },\n          0.5,\n        );\n\n        /* uneven keystrokes read as a person typing; the budget keeps long prompts inside 9s */\n        var KEY_GAPS = [\n          0.05, 0.035, 0.06, 0.04, 0.03, 0.055, 0.045, 0.07, 0.035, 0.05, 0.04, 0.065,\n        ];\n        var raw = 0;\n        for (var n = 1; n < prompt.length; n += 1) raw += KEY_GAPS[n % KEY_GAPS.length];\n        var squeeze = Math.min(1, 1.8 / Math.max(raw, 0.001));\n        var TYPE_START = 0.8;\n        var t = TYPE_START;\n        tl.set(\"#aar-typed\", { textContent: \"\" }, 0.001);\n        tl.set(\"#aar-caret\", { autoAlpha: 0 }, 0.001);\n        tl.set(\"#aar-caret\", { autoAlpha: 1 }, TYPE_START - 0.15);\n        for (var c = 1; c <= prompt.length; c += 1) {\n          tl.set(\"#aar-typed\", { textContent: prompt.slice(0, c) }, t);\n          t += KEY_GAPS[c % KEY_GAPS.length] * squeeze;\n        }\n        var typeEnd = t;\n        tl.set(\"#aar-caret\", { autoAlpha: 0 }, typeEnd + 0.2);\n\n        var THINK = typeEnd + 0.4;\n        tl.fromTo(\n          \"#aar-thinking\",\n          { autoAlpha: 0 },\n          { autoAlpha: 1, duration: 0.15, ease: \"none\" },\n          THINK,\n        );\n        gsap.utils.toArray(\".aar-dot\").forEach(function (dot, i) {\n          for (var b = 0; b < 2; b += 1) {\n            var at = THINK + 0.1 + b * 0.32 + i * 0.08;\n            tl.to(dot, { y: -9, duration: 0.14, ease: \"sine.out\" }, at);\n            tl.to(dot, { y: 0, duration: 0.14, ease: \"sine.in\" }, at + 0.14);\n          }\n        });\n        var LEAD = THINK + 0.85;\n        tl.to(\"#aar-thinking\", { autoAlpha: 0, duration: 0.12, ease: \"none\" }, LEAD - 0.12);\n        tl.fromTo(\n          \"#aar-star\",\n          { autoAlpha: 0, scale: 0.3, rotation: -90 },\n          { autoAlpha: 1, scale: 1, rotation: 0, duration: 0.45, ease: \"back.out(2)\" },\n          LEAD,\n        );\n        words.forEach(function (w, i) {\n          tl.set(w, { opacity: 1 }, LEAD + 0.12 + i * 0.07);\n        });\n\n        var ROWS = LEAD + 0.25 + words.length * 0.07;\n        rows.forEach(function (row, i) {\n          var at = ROWS + i * 0.16;\n          tl.fromTo(\n            \"#aar-rank-\" + (i + 1),\n            { autoAlpha: 0 },\n            { autoAlpha: 1, duration: 0.3, ease: \"none\" },\n            at,\n          );\n          tl.fromTo(\n            row,\n            { autoAlpha: 0, y: 24 },\n            { autoAlpha: 1, y: 0, duration: 0.45, ease: \"power3.out\" },\n            at,\n          );\n        });\n\n        /* picks step down rather than trade places, so the eye can follow each one to its new rank */\n        var RERANK = ROWS + 0.32 + 0.45 + 0.95;\n        rows.forEach(function (row, i) {\n          if (i < slot) return;\n          tl.to(row, { y: SLOT, duration: 0.55, ease: \"power3.inOut\" }, RERANK);\n          if (i === 2) tl.to(row, { autoAlpha: 0, duration: 0.4, ease: \"power1.in\" }, RERANK + 0.1);\n        });\n        /* the brand waits until its slot is mostly clear, so it never lands on the row leaving it */\n        tl.fromTo(\n          brandRow,\n          { autoAlpha: 0, x: 96 },\n          { autoAlpha: 1, x: 0, duration: 0.55, ease: \"power3.out\" },\n          RERANK + 0.34,\n        );\n\n        var LAND = RERANK + 0.9;\n        tl.fromTo(\n          \"#aar-hl\",\n          { autoAlpha: 0 },\n          { autoAlpha: 1, duration: 0.3, ease: \"power1.out\" },\n          LAND,\n        );\n        tl.fromTo(\n          \"#aar-tile-accent\",\n          { autoAlpha: 0 },\n          { autoAlpha: 1, duration: 0.3, ease: \"power1.out\" },\n          LAND,\n        );\n        tl.fromTo(\n          \"#aar-check\",\n          { autoAlpha: 0, scale: 0.4 },\n          { autoAlpha: 1, scale: 1, duration: 0.42, ease: \"back.out(2.2)\" },\n          LAND + 0.05,\n        );\n        tl.fromTo(\n          checkPath,\n          { strokeDashoffset: checkLen },\n          { strokeDashoffset: 0, duration: 0.34, ease: \"power2.out\" },\n          LAND + 0.2,\n        );\n\n        tl.set({}, {}, 9);\n        window.__timelines[\"ai-answer-rank\"] = tl;\n      })();\n    </script>\n  </body>\n</html>\n"}