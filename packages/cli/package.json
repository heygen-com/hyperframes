{
  "name": "@hyperframes/cli",
  "version": "0.8.221",
  "description": "Make videos with code and AI agents: write HTML, render MP4. Open source.",
  "keywords": [
    "ai-agents",
    "animation",
    "claude-code",
    "codex",
    "cursor",
    "gsap",
    "html-to-video",
    "hyperframes",
    "motion-graphics",
    "mp4",
    "remotion-alternative",
    "render",
    "video",
    "video-editor"
  ],
  "homepage": "https://hyperframes.heygen.com",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/heygen-com/hyperframes",
    "directory": "packages/cli"
  },
  "bin": {
    "hyperframes": "./bin/hyperframes.mjs",
    "hyperframes-localize-fonts": "./bin/hyperframes-localize-fonts.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "type": "module",
  "exports": {
    "./api": {
      "import": "./dist/api.js",
      "types": "./dist/api.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "dev": "tsx src/cli.ts",
    "build": "bun run build:fonts && tsup && bun run build:runtime && bun run build:copy",
    "build:fonts": "node scripts/build-fonts.mjs",
    "build:runtime": "tsx scripts/build-runtime.ts",
    "build:copy": "node scripts/build-copy.mjs",
    "typecheck": "tsc --noEmit",
    "gen:skills-manifest": "tsx scripts/gen-skills-manifest.ts",
    "gen:agent-dirs": "tsx scripts/sync-agent-dirs.ts",
    "bench:startup": "node scripts/bench-startup.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.5",
    "@puppeteer/browsers": "^3.2.2",
    "acorn": "^8.17.0",
    "adm-zip": "^0.6.0",
    "citty": "^0.2.1",
    "compare-versions": "^6.1.1",
    "css-tree": "^3.2.1",
    "debug": "^4.4.0",
    "esbuild": "^0.28.2",
    "fontkit": "^2.0.4",
    "giget": "^3.2.0",
    "hono": "^4.0.0",
    "ignore": "^5.3.2",
    "open": "^10.0.0",
    "postcss": "^8.5.8",
    "puppeteer-core": "^25.10.0",
    "undici": "7.25.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@clack/prompts": "^1.1.0",
    "@google/genai": "1.52.0",
    "@hyperframes/aws-lambda": "workspace:*",
    "@hyperframes/core": "workspace:*",
    "@hyperframes/engine": "workspace:*",
    "@hyperframes/gcp-cloud-run": "workspace:*",
    "@hyperframes/inspector": "workspace:*",
    "@hyperframes/lint": "workspace:*",
    "@hyperframes/parsers": "workspace:*",
    "@hyperframes/producer": "workspace:*",
    "@hyperframes/studio": "workspace:*",
    "@hyperframes/studio-server": "workspace:*",
    "@types/css-tree": "^3.2.0",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^25.0.10",
    "ajv": "^8.20.0",
    "linkedom": "^0.18.12",
    "onnxruntime-node": "1.21.1",
    "picocolors": "^1.1.1",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.11"
  },
  "optionalDependencies": {
    "sharp": "^0.35.0"
  },
  "engines": {
    "node": ">=22"
  }
}
