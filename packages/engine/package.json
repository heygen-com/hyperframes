{
  "name": "@hyperframes/engine",
  "version": "0.8.220",
  "description": "Seekable web page to video rendering engine (Puppeteer + FFmpeg)",
  "repository": {
    "type": "git",
    "url": "https://github.com/heygen-com/hyperframes",
    "directory": "packages/engine"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./alpha-blit": {
      "bun": "./src/utils/alphaBlit.ts",
      "import": "./src/utils/alphaBlit.ts",
      "types": "./src/utils/alphaBlit.ts"
    },
    "./chrome-host-ceiling": {
      "bun": "./src/services/chromeHostCeiling.ts",
      "import": "./src/services/chromeHostCeiling.ts",
      "types": "./src/services/chromeHostCeiling.ts"
    },
    "./chrome-startup": {
      "bun": "./src/services/chromeStartup.ts",
      "import": "./src/services/chromeStartup.ts",
      "types": "./src/services/chromeStartup.ts"
    },
    "./system-memory": {
      "bun": "./src/services/systemMemory.ts",
      "import": "./src/services/systemMemory.ts",
      "types": "./src/services/systemMemory.ts"
    },
    "./wsl-host": {
      "bun": "./src/services/wslHost.ts",
      "import": "./src/services/wslHost.ts",
      "types": "./src/services/wslHost.ts"
    },
    "./shader-transitions": {
      "bun": "./src/utils/shaderTransitions.ts",
      "import": "./src/utils/shaderTransitions.ts",
      "types": "./src/utils/shaderTransitions.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      },
      "./alpha-blit": {
        "import": "./dist/utils/alphaBlit.js",
        "types": "./dist/utils/alphaBlit.d.ts"
      },
      "./chrome-host-ceiling": {
        "import": "./dist/services/chromeHostCeiling.js",
        "types": "./dist/services/chromeHostCeiling.d.ts"
      },
      "./chrome-startup": {
        "import": "./dist/services/chromeStartup.js",
        "types": "./dist/services/chromeStartup.d.ts"
      },
      "./system-memory": {
        "import": "./dist/services/systemMemory.js",
        "types": "./dist/services/systemMemory.d.ts"
      },
      "./wsl-host": {
        "import": "./dist/services/wslHost.js",
        "types": "./dist/services/wslHost.d.ts"
      },
      "./shader-transitions": {
        "import": "./dist/utils/shaderTransitions.js",
        "types": "./dist/utils/shaderTransitions.d.ts"
      },
      "./package.json": "./package.json"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "build": "tsc && node ../../scripts/rewrite-relative-import-extensions.mjs dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.5",
    "@hyperframes/core": "workspace:^",
    "@hyperframes/parsers": "workspace:^",
    "hono": "^4.6.0",
    "linkedom": "^0.18.12",
    "puppeteer": "~25.11.0",
    "puppeteer-core": "^25.11.0",
    "undici": "7.25.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.10",
    "@webgpu/types": "^0.1.69",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}
